<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>{{title}} {{invoiceNo}}</title>
<style>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body { font-family: Helvetica, Arial, sans-serif; font-size: 8pt; color: #000; line-height: 1.25;
    padding: 18pt; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .doc { border: 0.7pt solid #000; }
  table { border-collapse: collapse; width: 100%; }
  td, th { border: 0.6pt solid #000; padding: 2pt 4pt; vertical-align: top; }
  .no-b, .no-b td, .no-b th { border: none; }
  .c { text-align: center; } .r { text-align: right; } .b { font-weight: bold; }
  .muted { font-size: 7.5pt; }
  /* Letterhead: text is centred across the page; when a logo is present the
     block reserves equal gutters on both sides so the centred text stays
     visually balanced and never runs under the logo. The logo is vertically
     centred against the whole letterhead rather than pinned to the top. */
  .head { position: relative; text-align: center; padding: 6pt 8pt; }
  .head.has-logo { padding-left: 74pt; padding-right: 74pt; min-height: 66pt; }
  .head .logo { position: absolute; left: 8pt; top: 50%; transform: translateY(-50%);
    width: 60pt; height: 60pt; object-fit: contain; }
  .head .co { font-weight: bold; font-size: 13pt; letter-spacing: .3pt; }
  .head .ln { font-size: 7.5pt; }
  .head .strong { font-weight: bold; }
  .bar td { font-weight: bold; }
  .bar .nowrap { white-space: nowrap; }
  /* Centred invoice title banner with Sl.NO pinned to the right edge. */
  .title-cell { position: relative; font-size: 10.5pt; letter-spacing: .5pt; }
  .title-cell .slno { position: absolute; right: 4pt; top: 50%; transform: translateY(-50%); font-size: 8pt; }
  /* Party cells: a fixed 4-column grid — label / value / label / value — so
     EVERY colon lines up. Labels sit in fixed-width `.k` cells and each value
     carries its own leading ": ", so all colons align vertically (left pair at
     one x, right pair at another). `table-layout:fixed` keeps the columns put. */
  .parties td { vertical-align: top; }
  .parties .kv { width: 100%; table-layout: fixed; border-collapse: collapse; }
  .parties .kv td { border: none; padding: 0.4pt 0; font-size: 7.5pt; vertical-align: top; }
  .parties .kv .k { width: 26pt; white-space: nowrap; }
  .parties .kv .v { width: calc(50% - 26pt); white-space: nowrap; }
  .items th { font-weight: bold; font-size: 7pt; text-align: center; vertical-align: middle; }
  .items td { font-size: 8pt; }
  .grand td { font-size: 12pt; font-weight: bold; }
  .foot td { font-size: 8pt; }
</style>
</head>
<body>
<div class="doc">
  <!-- Letterhead -->
  <div class="head{{#if co.logoDataUri}} has-logo{{/if}}">
    {{#if co.logoDataUri}}<img class="logo" src="{{co.logoDataUri}}">{{/if}}
    <div class="co">{{co.name}}</div>
    {{#if co.idValue}}<div class="ln strong">{{co.idLabel}}: {{co.idValue}}</div>{{/if}}
    <div class="ln">{{co.address1}}{{#if co.address2}}, {{co.address2}}{{/if}}</div>
    <div class="ln">{{co.place}}{{#if co.pin}} - {{co.pin}}{{/if}}, {{co.stateName}}, CODE: {{co.stateCode}}.</div>
    {{#if co.phone}}<div class="ln">Ph: {{co.phone}}{{#if co.email}} E-mail: {{co.email}}{{/if}}</div>{{/if}}
    <div class="ln strong">{{#if co.fssai}}FSSAI: {{co.fssai}} | {{/if}}GSTIN: {{co.gstin}}{{#if co.sbl}} | SBL: {{co.sbl}}{{/if}}{{#if co.pan}} | PAN: {{co.pan}}{{/if}}</div>
  </div>

  <!-- Title strip — the invoice title is centred across the FULL width (one
       cell spanning every column so the horizontal rule runs edge to edge),
       with Sl.NO pinned to the right. TAX INVOICE stays centred, Date on a
       single line. -->
  <table>
    <tr class="bar"><td colspan="3" class="c title-cell">AUCTION SALES INVOICE<span class="slno nowrap">Sl.NO: {{invoiceNo}}</span></td></tr>
    <tr class="bar"><td style="width:35%">Auction No:{{auctionNo}}</td><td class="c" style="width:30%">TAX INVOICE</td><td class="r nowrap" style="width:35%">Date: {{shortDate invoiceDate}}</td></tr>
  </table>

  <!-- Parties. Billed-To and Shipped-To use the same aligned two-column body
       (place/PAN, STATE/CODE, GST/SBL line up in columns). When the row has no
       separate consignee the builder mirrors Billed-To into `ship`, so
       Shipped-To always shows a full address rather than a blank/placeholder. -->
  <table class="parties">
    <tr class="bar c"><td style="width:50%">Details of the Receiver (Billed To)</td><td style="width:50%">Details of the Consignee (Shipped To)</td></tr>
    <tr>
      <td>{{#with billTo}}
        <div class="b">Sri/M/s.{{name}}</div>
        {{#if addr}}<div class="muted">{{addr}}</div>{{/if}}
        <table class="kv">
          <tr><td class="v" colspan="2">{{place}}</td><td class="k">PAN</td><td class="v">{{#if pan}}: <span class="b">{{pan}}</span>{{/if}}</td></tr>
          {{#if state}}<tr><td class="k">STATE</td><td class="v">: <span class="b">{{state}}</span></td><td class="k">CODE</td><td class="v">: <span class="b">{{stCode}}</span></td></tr>{{/if}}
          {{#if gstin}}<tr><td class="k">GST</td><td class="v">: <span class="b">{{gstin}}</span></td><td class="k">SBL</td><td class="v">{{#if sbl}}: <span class="b">{{sbl}}</span>{{/if}}</td></tr>{{/if}}
        </table>
      {{/with}}</td>
      <td>{{#with ship}}
        <div class="b">Sri/M/s.{{name}}</div>
        {{#if addr}}<div class="muted">{{addr}}</div>{{/if}}
        <table class="kv">
          <tr><td class="v" colspan="2">{{place}}</td><td class="k">PAN</td><td class="v">{{#if pan}}: <span class="b">{{pan}}</span>{{/if}}</td></tr>
          {{#if state}}<tr><td class="k">STATE</td><td class="v">: <span class="b">{{state}}</span></td><td class="k">CODE</td><td class="v">: <span class="b">{{stCode}}</span></td></tr>{{/if}}
          {{#if gstin}}<tr><td class="k">GST</td><td class="v">: <span class="b">{{gstin}}</span></td><td class="k">SBL</td><td class="v">{{#if sbl}}: <span class="b">{{sbl}}</span>{{/if}}</td></tr>{{/if}}
        </table>
      {{/with}}</td>
    </tr>
  </table>

  <table><tr class="bar c"><td>Commodity: Cardamom | HSN: {{hsnCardamom}}</td></tr></table>

  <!-- Line items -->
  <table class="items">
    <thead><tr>
      <th style="width:26pt">Lot<br>No</th>
      <th style="width:48pt">Item</th>
      <th>Qty<br>(kg.gr)</th>
      <th style="width:26pt">Bags</th>
      <th>Rate</th>
      <th>Value</th>
      <th>Taxable Value</th>
      <th>CGST<br>{{gstHalf}}%</th>
      <th>SGST<br>{{gstHalf}}%</th>
      <th>IGST {{gstRate}}%</th>
      <th>Total</th>
    </tr></thead>
    <tbody>
      {{#each rows}}
      <tr>
        <td class="c b">{{lot}}</td>
        <td>Cardamom</td>
        <td class="r">{{qty qty}}</td>
        <td class="c">{{bags}}</td>
        <td class="r">{{inr rate}}</td>
        <td class="r">{{inr amount}}</td>
        <td class="r">{{inr amount}}</td>
        <td class="r">{{inr cgst}}</td>
        <td class="r">{{inr sgst}}</td>
        <td class="r">{{inr igst}}</td>
        <td class="r">{{inr total}}</td>
      </tr>
      {{/each}}
      {{#if gunny}}
      <tr>
        <td></td><td>Gunny</td><td></td><td class="c b">{{gunny.bags}}</td><td></td>
        <td class="r">{{inr gunny.amount}}</td><td class="r">{{inr gunny.amount}}</td>
        <td class="r">{{inr gunny.cgst}}</td><td class="r">{{inr gunny.sgst}}</td><td class="r">{{inr gunny.igst}}</td><td class="r">{{inr gunny.total}}</td>
      </tr>
      {{/if}}
      {{#if transport}}
      <tr>
        <td></td><td>Transport</td><td class="r b">{{qty transport.qty}}</td><td></td><td></td>
        <td class="r">{{inr transport.amount}}</td><td class="r">{{inr transport.amount}}</td>
        <td class="r">{{inr transport.cgst}}</td><td class="r">{{inr transport.sgst}}</td><td class="r">{{inr transport.igst}}</td><td class="r">{{inr transport.total}}</td>
      </tr>
      {{/if}}
      {{#if insurance}}
      <tr>
        <td></td><td>Insurance</td><td></td><td></td><td></td>
        <td class="r">{{inr insurance.amount}}</td><td class="r">{{inr insurance.amount}}</td>
        <td class="r">{{inr insurance.cgst}}</td><td class="r">{{inr insurance.sgst}}</td><td class="r">{{inr insurance.igst}}</td><td class="r">{{inr insurance.total}}</td>
      </tr>
      {{/if}}
      {{#with summary}}
      <tr class="b">
        <td colspan="6" class="r">Total Taxable Value &amp; Tax</td>
        <td class="r">{{inr taxableValue}}</td>
        <td class="r">{{inr cgst}}</td>
        <td class="r">{{inr sgst}}</td>
        <td class="r">{{inr igst}}</td>
        <td class="r">{{inr (add (add taxableValue (add cgst sgst)) igst)}}</td>
      </tr>
      <tr><td colspan="10" class="r">Round Off</td><td class="r">{{inr roundDiff}}</td></tr>
      {{/with}}
    </tbody>
  </table>

  <!-- Grand total -->
  {{#with summary}}
  <table><tr class="grand"><td class="r" style="width:70%">Grand Total</td><td class="r">{{inr grandTotal}}</td></tr></table>
  <table><tr class="b"><td>Amount in Words: INR {{words grandTotal}} Only</td></tr></table>
  {{/with}}

  <!-- Footer -->
  <table class="no-b">
    <tr><td class="muted" style="padding-top:4pt">Electronic Reference Number:</td></tr>
    <tr><td class="muted b">E &amp; O.E certified that the particulars given above are true and correct</td></tr>
  </table>
  <!-- Bank details centred across the full width; "For <company>" pinned to the
       right of the same band, signatures on the row below. -->
  <table class="no-b foot">
    <tr>
      <td class="c" style="position:relative">
        {{#if bank}}
        <div class="b">Bank Details</div>
        <div>{{bank.name}}</div>
        <div>A/C# {{bank.acct}}</div>
        <div>IFSC: {{bank.ifsc}}</div>
        {{/if}}
        <div class="b" style="position:absolute; right:4pt; top:0">For {{forCompany}}</div>
      </td>
    </tr>
    <tr>
      <td style="position:relative; padding-top:26pt">
        <span class="b">Signature of the authorized buyer</span>
        <span class="b" style="position:absolute; right:4pt; bottom:0">Authorised Signatory</span>
      </td>
    </tr>
  </table>
</div>
</body>
</html>
