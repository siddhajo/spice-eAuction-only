<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>{{title}} {{invoiceNo}}</title>
<style>
  /* `paged` — see the note by .sheet below: a multi-page invoice gives up
     30pt top and bottom for the renderer's "Page x of y" / "Continued on next
     page.." lines. This @page rule is what actually reserves them; Chromium
     lets CSS page margins override the ones the print call asks for. */
  @page { size: A4; margin: {{#if paged}}30pt 0{{else}}0{{/if}}; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  /* Only the SIDE gutters live on <body>: horizontal padding applies to every
     page, but top/bottom padding is spent once — on page 1's top and the last
     page's bottom — which left a spilled-over page butting against the paper
     edge. The vertical page margins are carried by the .sheet header/footer
     groups instead (see below), so every page gets the same 18pt frame. */
  body { font-family: Helvetica, Arial, sans-serif; font-size: 8pt; color: #000; line-height: 1.25;
    padding: 0 18pt; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  table { border-collapse: collapse; width: 100%; }
  td, th { border: 0.6pt solid #000; padding: 2pt 4pt; vertical-align: top; }
  .no-b, .no-b td, .no-b th { border: none; }
  .c { text-align: center; } .r { text-align: right; } .b { font-weight: bold; }
  .muted { font-size: 7.5pt; }
  /* Letterhead: text is centred across the page; when a logo is present the
     block reserves equal gutters on both sides so the centred text stays
     visually balanced and never runs under the logo. The logo is vertically
     centred against the whole letterhead rather than pinned to the top. */
  .head { position: relative; text-align: center; padding: 6pt 8pt; }
  .head.has-logo { padding-left: 74pt; padding-right: 74pt; min-height: 66pt; }
  .head .logo { position: absolute; left: 8pt; top: 50%; transform: translateY(-50%);
    width: 60pt; height: 60pt; object-fit: contain; }
  .head .co { font-weight: bold; font-size: 13pt; letter-spacing: .3pt; }
  .head .ln { font-size: 7.5pt; }
  /* Statutory-ID rows: centred, pipe-separated, each item unbreakable. */
  .head .ids { display: flex; flex-wrap: wrap; justify-content: center; column-gap: 5pt; }
  .head .ids:empty { display: none; }
  .head .ids span { white-space: nowrap; }
  .head .ids span + span::before { content: '|'; padding-right: 5pt; color: #555; }
  .head .strong { font-weight: bold; }
  /* Soft-green header/band + column-header fill, matching the commission bill. */
  .bar td { font-weight: bold; background: #e8f1e0; }
  .bar .nowrap { white-space: nowrap; }
  /* Centred invoice title banner with Sl.NO pinned to the right edge. */
  .title-cell { position: relative; font-size: 10.5pt; letter-spacing: .5pt; }
  .title-cell .slno { position: absolute; right: 4pt; top: 50%; transform: translateY(-50%); font-size: 8pt; }
  /* Party cells: a fixed 4-column grid — label / value / label / value — so
     EVERY colon lines up. Labels sit in fixed-width `.k` cells and each value
     carries its own leading ": ", so all colons align vertically (left pair at
     one x, right pair at another). `table-layout:fixed` keeps the columns put. */
  .parties td { vertical-align: top; }
  .parties .kv { width: 100%; table-layout: fixed; border-collapse: collapse; }
  /* Party box (the partyBox helper) — name, street, town-PIN, state+code,
     then the remaining details two per row. Fixed columns so the right-hand
     values line up down the box. */
  .parties .pb { width: 100%; table-layout: fixed; border-collapse: collapse; }
  .parties .pb td { height: auto; border: 0; padding: 0; font-size: 8pt; vertical-align: top; white-space: nowrap; }
  .parties .pb td[colspan] { white-space: normal; }
  .parties .pb .pb-nm, .parties .pb .pb-v { font-weight: bold; }
  .parties .kv td { border: none; padding: 0.4pt 0; font-size: 7.5pt; vertical-align: top; width: 50%; white-space: nowrap; }
  /* Left-aligned labels in a fixed-width box so every colon lines up in a column. */
  .parties .kv .lbl { display: inline-block; width: 26pt; }
  .items th { font-weight: bold; font-size: 7pt; text-align: center; vertical-align: middle; background: #e8f1e0; }
  .items td { font-size: 8pt; }
  .grand td { font-size: 12pt; font-weight: bold; }
  .foot td { font-size: 8pt; }
  /* ── Repeating page header ───────────────────────────────────────────────
     The letterhead, the title strip and the two party boxes must appear at the
     top of EVERY page, not just page 1. The document therefore sits in
     borderless full-width wrapper tables whose <thead> carries that header:
     Chromium repeats a table header group on each page the table spans, so a
     long invoice that spills onto page 2+ reprints the company details and the
     Billed-To / Shipped-To boxes above the continued line items.

     Why TWO nested tables (.sheet holding .sheet2) rather than one: Chromium
     silently STOPS repeating a header group once it is taller than 25% of the
     page (210.5pt on A4). Letterhead + title strip + party boxes together run
     ~193pt, so a single header sat a couple of address lines away from that
     cliff — and past it the header would just vanish from page 2 with no other
     sign. Splitting it in two (outer = letterhead + the page's top margin,
     inner = title strip + parties) measures each group against the cap on its
     own, which leaves both at less than half of it. Keep it that way: anything
     added to one of these headers eats that company's margin, not both. */
  .sheet, .sheet2 { width: 100%; border-collapse: collapse; }
  .sheet > thead, .sheet2 > thead { display: table-header-group; }
  .sheet > tfoot { display: table-footer-group; }
  .sheet > thead > tr > td, .sheet > tbody > tr > td, .sheet > tfoot > tr > td,
  .sheet2 > thead > tr > td, .sheet2 > tbody > tr > td {
    border: 0; padding: 0; text-align: left; font-weight: normal; vertical-align: top; }
  /* Vertical page margins, applied PER PAGE instead of once per document: the
     header group opens every page with 18pt of air and the footer group's
     spacer row closes it — Chromium reserves a repeated footer group's height
     on every page the table spans, so no row can reach the paper edge. Kept as
     layout (not @page margins) because the Electron backend prints with
     marginType:'none', which discards CSS page margins. */
  .sheet > thead > tr > td { padding-top: {{#if paged}}0{{else}}18pt{{/if}}; }
  .sheet > tfoot > tr > td.pagefoot { padding-bottom: {{#if paged}}0{{else}}18pt{{/if}}; }
{{#if paged}}
  /* `paged` — this invoice runs to more than one page, so the renderer is
     printing "Page x of y" / "Continued on next page.." into REAL page margins
     (see generateSalesInvoiceHtmlPDF). Those margins now provide the per-page
     gutter the two rules above normally carry; keeping both would double it. */
{{/if}}
  /* …and the document's outer box is drawn by those same groups, so it sits
     INSIDE that margin on every page instead of running off the paper edge:
     the header opens it (top + sides), the two body groups carry the sides,
     and the repeated footer closes it at the foot of each page. */
  .frame { border-left: 0.7pt solid #000; border-right: 0.7pt solid #000; }
  .frame-top { border-top: 0.7pt solid #000; }
  .frame-bot { height: 0; border-bottom: 0.7pt solid #000; }
  /* Never split a line item (or a party box) across the page break. */
  .items tr, .parties tr { page-break-inside: avoid; break-inside: avoid; }
  /* The charge rows (Sample/Gunny/Transport/Insurance) and the two totals rows
     are the table's closing cluster — they ride to the next page together
     rather than leaving "Total Taxable Value & Tax" stranded without its
     Round Off line. */
  .items tbody.totals { page-break-inside: avoid; break-inside: avoid; }
  /* The closing block — grand total, amount in words, the E&OE note, bank
     details and the signature band — is ONE unit: when it doesn't fit under
     the last line item it moves to the next page whole, instead of tearing
     between "Bank Details" and the account number. */
  .tail { page-break-inside: avoid; break-inside: avoid; }
</style>
</head>
<body>
<div class="doc">
<table class="sheet">
<thead><tr><td><div class="frame frame-top">
  <!-- Letterhead -->
  <div class="head{{#if co.logoDataUri}} has-logo{{/if}}">
    {{#if co.logoDataUri}}<img class="logo" src="{{co.logoDataUri}}">{{/if}}
    <div class="co">{{co.name}}</div>
    {{#if co.idValue}}<div class="ln strong">{{co.idLabel}}: {{co.idValue}}</div>{{/if}}
    <div class="ln">{{co.address1}}{{#if co.address2}}, {{co.address2}}{{/if}}</div>
    <div class="ln">{{co.place}}{{#if co.pin}} - {{co.pin}}{{/if}}, {{co.stateName}}, CODE: {{co.stateCode}}.</div>
    {{#if co.phone}}<div class="ln">Ph: {{co.phone}}{{#if co.email}} E-mail: {{co.email}}{{/if}}</div>{{/if}}
    <!-- Statutory IDs on two balanced rows (FSSAI · GSTIN / SBL · PAN) so a
         long SBL never wraps mid-value and orphans "PAN:" on its own line. -->
    <div class="ln strong ids">{{#if co.fssai}}<span>FSSAI:&nbsp;{{co.fssai}}</span>{{/if}}{{#if co.gstin}}<span>GSTIN:&nbsp;{{co.gstin}}</span>{{/if}}</div>
    <div class="ln strong ids">{{#if co.sbl}}<span>SBL:&nbsp;{{co.sbl}}</span>{{/if}}{{#if co.pan}}<span>PAN:&nbsp;{{co.pan}}</span>{{/if}}</div>
  </div>
</div></td></tr></thead>
<tbody><tr><td>
<table class="sheet2">
<thead><tr><td><div class="frame">

  <!-- Title strip — the invoice title is centred across the FULL width (one
       cell spanning every column so the horizontal rule runs edge to edge),
       with Sl.NO pinned to the right. TAX INVOICE stays centred, Date on a
       single line. -->
  <table>
    <tr class="bar"><td colspan="3" class="c title-cell">AUCTION SALES INVOICE<span class="slno nowrap">Sl.NO: {{invoiceNo}}</span></td></tr>
    <tr class="bar"><td style="width:35%">Auction No:{{auctionNo}}</td><td class="c" style="width:30%">{{#if isProforma}}PROFORMA INVOICE{{else}}TAX INVOICE{{/if}}</td><td class="r nowrap" style="width:35%">Date: {{date invoiceDate dateFormat}}</td></tr>
  </table>

  <!-- Parties. Billed-To and Shipped-To use the same aligned two-column body
       (place/PAN, STATE/CODE, GST/SBL line up in columns). When the row has no
       separate consignee the builder mirrors Billed-To into `ship`, so
       Shipped-To always shows a full address rather than a blank/placeholder. -->
  <table class="parties">
    <tr class="bar c"><td style="width:50%">Details of the Receiver (Billed To)</td><td style="width:50%">Details of the Consignee (Shipped To)</td></tr>
    <tr>
      <td>{{{partyBox billTo.block prefix="M/s."}}}</td>
      <td>{{{partyBox ship.block prefix="M/s."}}}</td>
    </tr>
  </table>
</div></td></tr></thead>
<tbody><tr><td><div class="frame">

  <table><tr class="bar c"><td>Commodity: Cardamom | HSN: {{hsnCardamom}}</td></tr></table>

  <!-- Line items -->
  <table class="items">
    <thead><tr>
      <th style="width:26pt">Lot<br>No</th>
      <th style="width:48pt">Item</th>
      <th>Qty<br>(kg.gr)</th>
      <th style="width:26pt">Bags</th>
      <th>Rate</th>
      <th>Value</th>
      <th>Taxable Value</th>
      <th>CGST<br>{{gstHalf}}%</th>
      <th>SGST<br>{{gstHalf}}%</th>
      <th>IGST {{gstRate}}%</th>
      <th>Total</th>
    </tr></thead>
    <tbody>
      {{#each rows}}
      <tr>
        <td class="c b">{{lot}}</td>
        <td>Cardamom</td>
        <td class="r">{{qty qty}}</td>
        <td class="c">{{bags}}</td>
        <td class="r">{{inr rate}}</td>
        <td class="r">{{inr amount}}</td>
        <td class="r">{{inr amount}}</td>
        <td class="r">{{inr cgst}}</td>
        <td class="r">{{inr sgst}}</td>
        <td class="r">{{inr igst}}</td>
        <td class="r">{{inr total}}</td>
      </tr>
      {{/each}}
    </tbody>
    <tbody class="totals">
      {{#if sample}}
      <tr>
        <td></td><td>Sample</td>
        <td class="r">{{qty sample.qty}}</td><td></td>
        <td class="r">{{inr sample.amount}}</td>
        <td class="r">({{inr sample.amount}})</td>
        <td class="r">0</td>
        <td></td><td></td><td></td><td></td>
      </tr>
      {{/if}}
      {{#if gunny}}
      <tr>
        {{!-- Lot-No cell carries the LOT COUNT for this invoice, sitting
              directly under the lot numbers it totals — the same place the
              Gunny row already totals the bags column beside it. --}}
        <td class="c b">{{rows.length}}</td><td>Gunny</td><td></td><td class="c b">{{gunny.bags}}</td><td></td>
        <td class="r">{{inr gunny.amount}}</td><td class="r">{{inr gunny.amount}}</td>
        <td class="r">{{inr gunny.cgst}}</td><td class="r">{{inr gunny.sgst}}</td><td class="r">{{inr gunny.igst}}</td><td class="r">{{inr gunny.total}}</td>
      </tr>
      {{/if}}
      {{#if transport}}
      <tr>
        <td></td><td>Transport</td><td class="r b">{{qty transport.qty}}</td><td></td><td></td>
        <td class="r">{{inr transport.amount}}</td><td class="r">{{inr transport.amount}}</td>
        <td class="r">{{inr transport.cgst}}</td><td class="r">{{inr transport.sgst}}</td><td class="r">{{inr transport.igst}}</td><td class="r">{{inr transport.total}}</td>
      </tr>
      {{/if}}
      {{#if insurance}}
      <tr>
        <td></td><td>Insurance</td><td></td><td></td><td></td>
        <td class="r">{{inr insurance.amount}}</td><td class="r">{{inr insurance.amount}}</td>
        <td class="r">{{inr insurance.cgst}}</td><td class="r">{{inr insurance.sgst}}</td><td class="r">{{inr insurance.igst}}</td><td class="r">{{inr insurance.total}}</td>
      </tr>
      {{/if}}
      {{#with summary}}
      <tr class="b">
        <td colspan="6" class="r">Total Taxable Value &amp; Tax</td>
        <td class="r">{{inr taxableValue}}</td>
        <td class="r">{{inr cgst}}</td>
        <td class="r">{{inr sgst}}</td>
        <td class="r">{{inr igst}}</td>
        <td class="r">{{inr (add (add taxableValue (add cgst sgst)) igst)}}</td>
      </tr>
      <tr><td colspan="10" class="r">Round Off</td><td class="r">{{inr roundDiff}}</td></tr>
      {{/with}}
    </tbody>
  </table>

  <!-- Grand total, amount in words, footer and signatures — one unbreakable
       block (.tail) so a page break can never land inside it. -->
  <div class="tail">
  {{#with summary}}
  <table><tr class="grand"><td class="r" style="width:70%">Grand Total</td><td class="r">{{inr grandTotal}}</td></tr></table>
  <table><tr class="b"><td>Amount in Words: INR {{words grandTotal}} Only</td></tr></table>
  {{/with}}

  <!-- Footer -->
  <table class="no-b">
    <tr><td class="muted" style="padding-top:4pt">Electronic Reference Number:</td></tr>
    <tr><td class="muted b">E &amp; O.E certified that the particulars given above are true and correct</td></tr>
  </table>
  <!-- Bank details centred across the full width; "For <company>" pinned to the
       right of the same band, signatures on the row below. -->
  <table class="no-b foot">
    <tr>
      <td class="c" style="position:relative">
        {{#if bank}}
        <div class="b">Bank Details</div>
        <div>{{bank.name}}</div>
        <div>A/C# {{bank.acct}}</div>
        <div>IFSC: {{bank.ifsc}}</div>
        {{/if}}
        <div class="b" style="position:absolute; right:4pt; top:0">For {{forCompany}}</div>
      </td>
    </tr>
    <tr>
      <td style="position:relative; padding-top:26pt">
        <span class="b">Signature of the authorized buyer</span>
        <span class="b" style="position:absolute; right:4pt; bottom:0">Authorised Signatory</span>
      </td>
    </tr>
  </table>
  </div>
</div></td></tr></tbody>
</table>
</td></tr></tbody>
<!-- Repeated page footer: a pure spacer that reserves the bottom margin on
     EVERY page (see .pagefoot in the stylesheet). -->
<tfoot><tr><td class="pagefoot"><div class="frame frame-bot"></div></td></tr></tfoot>
</table>
</div>
</body>
</html>
