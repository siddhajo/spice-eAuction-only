{{#if first}}<style>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; }
  body { font-family: Helvetica, Arial, sans-serif; font-size: 8.5pt; color: #000; line-height: 1.3;
    -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .rns-page { padding: 22pt; }
  .rns-page + .rns-page { page-break-before: always; }
  .rns { --green: #4e8a3a; --green-soft: #e8f1e0; }
  .rns .doc { border: 1pt solid #000; }
  .rns table { border-collapse: collapse; width: 100%; }
  .rns td, .rns th { border: 0.7pt solid #000; padding: 3pt 5pt; vertical-align: top; }
  /* Letterhead: centred text; when a logo is present reserve equal gutters on
     both sides so the centred block stays balanced and clears the logo, and
     vertically centre the logo against the whole letterhead. */
  .rns .lead { position: relative; padding: 8pt; text-align: center; border: none; }
  .rns .lead.has-logo { padding-left: 78pt; padding-right: 78pt; min-height: 68pt; }
  .rns .logo { position: absolute; left: 8pt; top: 50%; transform: translateY(-50%);
    width: 62pt; height: 62pt; object-fit: contain; }
  .rns .co-name { font-weight: bold; font-size: 14pt; letter-spacing: .5pt; }
  .rns .co-sub { font-size: 8pt; }
  .rns .co-strong { font-weight: bold; }
  .rns .band td { background: var(--green); color: #fff; font-weight: bold; text-align: center; }
  .rns .band2 td { background: var(--green-soft); font-weight: bold; text-align: center; }
  .rns .hdr td { background: var(--green-soft); font-weight: bold; text-align: center; }
  .rns .party td { font-size: 8pt; vertical-align: top; height: 52pt; }
  .rns .center { text-align: center; } .rns .right { text-align: right; } .rns .bold { font-weight: bold; }
  .rns .items th { background: var(--green-soft); font-weight: bold; text-align: center; }
  .rns .items td { font-size: 8.5pt; }
  .rns .sumlbl { text-align: right; font-weight: bold; }
  .rns .words { padding: 5pt 6pt; font-weight: bold; }
  .rns .forco { text-align: right; font-weight: bold; padding: 4pt 6pt 0; }
  .rns .sigrow { display: flex; justify-content: space-between; font-weight: bold; font-size: 9pt; padding: 40pt 6pt 6pt; }
  .rns .kv { display: inline-block; }
</style>{{/if}}
<div class="rns-page rns">
  <div class="doc">
    <!-- Letterhead -->
    <div class="lead{{#if co.logoDataUri}} has-logo{{/if}}">
      {{#if co.logoDataUri}}<img class="logo" src="{{co.logoDataUri}}">{{/if}}
      <div class="co-name">{{co.name}}</div>
      {{#if co.idValue}}<div class="co-sub">{{co.idLabel}}: {{co.idValue}}</div>{{/if}}
      <div class="co-sub">{{co.address1}}{{#if co.address2}}, {{co.address2}}{{/if}}</div>
      <div class="co-sub">{{co.place}}{{#if co.pin}} - {{co.pin}}{{/if}}{{#if co.stateName}}, {{co.stateName}}, CODE: {{co.stateCode}}.{{/if}}</div>
      {{#if co.phone}}<div class="co-sub">Ph: {{co.phone}}{{#if co.email}} E-mail: {{co.email}}{{/if}}</div>{{/if}}
      <div class="co-sub">{{#if co.fssai}}FSSAI: {{co.fssai}} | {{/if}}GSTIN: {{co.gstin}}{{#if co.sbl}} | SBL: {{co.sbl}}{{/if}}{{#if co.pan}} | PAN: {{co.pan}}{{/if}}</div>
    </div>

    <!-- Meta bands -->
    <table>
      <tr class="band2">
        <td style="width:33%">Crop Receipt No: {{crpt}}</td>
        <td style="width:34%">Payment Voucher<br>[ MEMORANDUM OF CARDAMOM SOLD THROUGH {{cfg.short_name}} ]</td>
        <td style="width:33%">Bill No: {{billNo}}</td>
      </tr>
      <tr class="band">
        <td>Auction No: {{ano}}</td>
        <td>Lot No: {{lotNo}}</td>
        <td>Date: {{auctionDate}}</td>
      </tr>
    </table>

    <!-- Parties -->
    <table>
      <tr class="hdr"><td style="width:50%">DETAILS OF SELLER [BILLED FOR]</td>
          <td style="width:50%">DETAILS OF BUYER [SOLD TO]</td></tr>
      <tr class="party">
        <td>
          <div class="bold">Sri. {{seller.name}}</div>
          <div>{{#if seller.address}}{{seller.address}}{{else}}-{{/if}} &nbsp; {{seller.state}}</div>
          <div>STATE CODE: <span class="bold">{{seller.st_code}}</span>{{#if seller.aadhar}} &nbsp; AADHAR: <span class="bold">{{seller.aadhar}}</span>{{/if}}</div>
          <div>{{#if seller.cr}}CR.<span class="bold">{{seller.cr}}</span>{{/if}}{{#if seller.pan}} &nbsp; PAN: <span class="bold">{{seller.pan}}</span>{{/if}}</div>
          {{#if showSellerBank}}<div>{{#if seller.phone}}Ph: <span class="bold">{{seller.phone}}</span>{{/if}}{{#if seller.account}}{{#if seller.phone}} &nbsp; {{/if}}A/C: <span class="bold">{{seller.account}}</span>{{/if}}</div>{{/if}}
        </td>
        <td>
          <div class="bold">M/s. {{purchaser.name}}{{#if purchaser.invo}} &nbsp;&nbsp; INV: {{purchaser.invo}}{{/if}}</div>
          {{#if purchaser.address}}<div>{{purchaser.address}}</div>{{/if}}
          <div>{{purchaser.place}}{{#if purchaser.pin}} - {{purchaser.pin}}{{/if}}</div>
          <div>{{purchaser.state}} &nbsp; STATE CODE: {{purchaser.st_code}}</div>
          <div>{{#if purchaser.gstin}}GSTIN: <span class="bold">{{purchaser.gstin}}</span>{{/if}}{{#if purchaser.sbl}} &nbsp; SBL: <span class="bold">{{purchaser.sbl}}</span>{{/if}}</div>
        </td>
      </tr>
    </table>

    <!-- Line items -->
    <table class="items">
      <thead><tr>
        <th style="width:8%">S.No.</th><th style="width:37%">Description</th>
        <th style="width:18%">Quantity (kg.gr)</th><th style="width:15%">Rate</th><th style="width:22%">Cost</th>
      </tr></thead>
      <tbody>
        <tr>
          <td class="center">1</td><td>CARDAMOM (HSN: {{hsnCardamom}})</td>
          <td class="right">{{qtyg cardamom.qty}}</td><td class="right">{{rup cardamom.rate}}</td>
          <td class="right">{{rup cardamom.cost}}</td>
        </tr>
        {{#if sampleRefund}}
        <tr>
          <td class="center">2</td><td>SAMPLE REFUND</td>
          <td class="right">{{qtyg sampleRefund.qty}}</td><td class="right">{{rup sampleRefund.rate}}</td>
          <td class="right">{{rup sampleRefund.amount}}</td>
        </tr>
        {{/if}}
        {{#if traderSample}}
        <tr>
          <td class="center">3</td><td>TRADER SAMPLE</td>
          <td class="right">{{qtyg traderSample.qty}}</td><td class="right">({{rup traderSample.rate}})</td>
          <td class="right">({{rup traderSample.amount}})</td>
        </tr>
        {{/if}}
        <tr>
          <td class="center">4</td><td>COMMISSION</td>
          <td></td><td class="right">(1+2-3)*1%</td>
          <td class="right">({{rup commission.amount}})</td>
        </tr>
        <tr><td colspan="4" class="sumlbl">Taxable Value</td><td class="right bold">{{rup tax.taxable}}</td></tr>
        <tr><td colspan="4" class="sumlbl">CGST {{gstRate}}%</td><td class="right bold">{{rup tax.cgst}}</td></tr>
        <tr><td colspan="4" class="sumlbl">SGST {{gstRate}}%</td><td class="right bold">{{rup tax.sgst}}</td></tr>
        <tr><td colspan="4" class="sumlbl">IGST {{add gstRate gstRate}}%</td><td class="right bold">{{#if tax.igst}}{{rup tax.igst}}{{else}}0{{/if}}</td></tr>
        <tr><td colspan="4" class="sumlbl">Round Off</td><td class="right bold">{{rup roundDiff}}</td></tr>
        <tr><td colspan="4" class="sumlbl">Grand Total</td><td class="right bold">{{rup grandTotal}}</td></tr>
      </tbody>
    </table>

    <div class="words">Amount in Words: {{nettWords}}</div>
    <div class="forco">For {{cfg.short_name}}</div>
    <div class="sigrow"><span>Signature of the seller</span><span>Authorised Signatory</span></div>
  </div>
</div>
