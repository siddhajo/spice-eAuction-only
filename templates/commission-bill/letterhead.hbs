{{#if first}}<style>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; }
  body { font-family: Helvetica, Arial, sans-serif; font-size: 8.5pt; color: #000; line-height: 1.3;
    -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .letterhead-page { padding: 22pt; }
  .letterhead-page + .letterhead-page { page-break-before: always; }
  .letterhead { --green: #4e8a3a; --green-soft: #e8f1e0; }
  .letterhead .doc { border: 1pt solid #000; }
  .letterhead table { border-collapse: collapse; width: 100%; }
  .letterhead td, .letterhead th { border: 0.7pt solid #000; padding: 3pt 5pt; vertical-align: top; }
  /* Letterhead: centred text; when a logo is present reserve equal gutters on
     both sides so the centred block stays balanced and clears the logo, and
     vertically centre the logo against the whole letterhead. */
  .letterhead .lead { position: relative; padding: 8pt; text-align: center; border: none; }
  .letterhead .lead.has-logo { padding-left: 78pt; padding-right: 78pt; min-height: 68pt; }
  .letterhead .logo { position: absolute; left: 8pt; top: 50%; transform: translateY(-50%);
    width: 62pt; height: 62pt; object-fit: contain; }
  .letterhead .co-name { font-weight: bold; font-size: 14pt; letter-spacing: .5pt; }
  .letterhead .co-sub { font-size: 8pt; }
  .letterhead .co-strong { font-weight: bold; }
  /* Statutory-ID rows: centred, pipe-separated, each item unbreakable. */
  .letterhead .co-ids { display: flex; flex-wrap: wrap; justify-content: center; column-gap: 6pt; }
  .letterhead .co-ids:empty { display: none; }
  .letterhead .co-ids span { white-space: nowrap; }
  .letterhead .co-ids span + span::before { content: '|'; padding-right: 6pt; color: #555; }
  .letterhead .band td { background: var(--green); color: #fff; font-weight: bold; text-align: center; }
  .letterhead .band2 td { background: var(--green-soft); font-weight: bold; text-align: center; }
  .letterhead .hdr td { background: var(--green-soft); font-weight: bold; text-align: center; }
  .letterhead .party td { font-size: 8pt; vertical-align: top; }
  .letterhead .center { text-align: center; } .letterhead .right { text-align: right; } .letterhead .bold { font-weight: bold; }
  .letterhead .items th { background: var(--green-soft); font-weight: bold; text-align: center; }
  .letterhead .items td { font-size: 8.5pt; }
  .letterhead .sumlbl { text-align: right; font-weight: bold; }
  .letterhead .words { padding: 5pt 6pt; font-weight: bold; }
  .letterhead .forco { text-align: right; font-weight: bold; padding: 4pt 6pt 0; }
  .letterhead .sigrow { display: flex; justify-content: space-between; font-weight: bold; font-size: 9pt; padding: 40pt 6pt 6pt; }
  .letterhead .kv { display: inline-block; }
  /* Party detail grid: a borderless 2-column table inside each party cell so
     the right-hand column (state / aadhar / pan · state-code / sbl) lines up
     vertically and the seller block mirrors the buyer block. */
  .letterhead .pkv { width: 100%; border: 0; margin-top: 0; }
  .letterhead .pkv td { border: 0; padding: 0; font-size: 8pt; line-height: 1.1; vertical-align: top; }
  .letterhead .pkv td.rc { width: 42%; }
  /* Keep every "LABEL: value" pair on one line — a narrow right-hand cell used
     to break after the colon and orphan the value (e.g. "SBL:" / "CS/A2623…").
     The wrapping address rows are the colspan ones, so they opt back out. */
  .letterhead .pkv td { white-space: nowrap; }
  .letterhead .pkv td[colspan] { white-space: normal; }
</style>{{/if}}
<div class="letterhead-page letterhead">
  <div class="doc">
    <!-- Letterhead -->
    <div class="lead{{#if co.logoDataUri}} has-logo{{/if}}">
      {{#if co.logoDataUri}}<img class="logo" src="{{co.logoDataUri}}">{{/if}}
      <div class="co-name">{{co.name}}</div>
      {{#if co.idValue}}<div class="co-sub">{{co.idLabel}}: {{co.idValue}}</div>{{/if}}
      <div class="co-sub">{{co.address1}}{{#if co.address2}}, {{co.address2}}{{/if}}</div>
      <div class="co-sub">{{co.place}}{{#if co.pin}} - {{co.pin}}{{/if}}{{#if co.stateName}}, {{co.stateName}}, CODE: {{co.stateCode}}.{{/if}}</div>
      {{#if co.phone}}<div class="co-sub">Ph: {{co.phone}}{{#if co.email}} E-mail: {{co.email}}{{/if}}</div>{{/if}}
      <!-- Statutory IDs on two balanced rows (FSSAI · GSTIN / SBL · PAN) so a
           long SBL never wraps mid-value and orphans "PAN:" on its own line.
           Each item is nowrap; an empty row collapses via :empty. -->
      <div class="co-sub co-ids">{{#if co.fssai}}<span>FSSAI:&nbsp;{{co.fssai}}</span>{{/if}}{{#if co.gstin}}<span>GSTIN:&nbsp;{{co.gstin}}</span>{{/if}}</div>
      <div class="co-sub co-ids">{{#if co.sbl}}<span>SBL:&nbsp;{{co.sbl}}</span>{{/if}}{{#if co.pan}}<span>PAN:&nbsp;{{co.pan}}</span>{{/if}}</div>
    </div>

    <!-- Meta bands -->
    <table>
      <tr class="band2">
        <td style="width:33%">Crop Receipt No: {{crpt}}</td>
        <td style="width:34%">Payment Voucher<br>[ MEMORANDUM OF CARDAMOM SOLD THROUGH {{cfg.short_name}} ]</td>
        <td style="width:33%">Bill No: {{billNo}}</td>
      </tr>
      <tr class="band">
        <td>Auction No: {{ano}}</td>
        <td>Lot No: {{lotNo}}</td>
        <td>Date: {{auctionDate}}</td>
      </tr>
    </table>

    <!-- Parties -->
    <table>
      <tr class="hdr"><td style="width:50%">DETAILS OF SELLER [BILLED FOR]</td>
          <td style="width:50%">DETAILS OF BUYER [SOLD TO]</td></tr>
      <tr class="party">
        <td>
          <div class="bold">Sri. {{seller.name}}</div>
          <table class="pkv"><tbody>
            <tr><td colspan="2">{{seller.addressFull}}</td></tr>
            <tr><td>STATE CODE: <span class="bold">{{seller.st_code}}</span></td><td class="rc">{{#if seller.aadhar}}AADHAR: <span class="bold">{{seller.aadhar}}</span>{{/if}}</td></tr>
            <tr><td>{{#if seller.cr}}CR.<span class="bold">{{seller.cr}}</span>{{/if}}</td><td class="rc">{{#if seller.pan}}PAN: <span class="bold">{{seller.pan}}</span>{{/if}}</td></tr>
            {{#if showSellerBank}}<tr><td colspan="2">{{#if seller.phone}}Ph: <span class="bold">{{seller.phone}}</span>{{/if}}{{#if seller.account}}{{#if seller.phone}} &nbsp; {{/if}}A/C: <span class="bold">{{seller.account}}</span>{{/if}}</td></tr>{{/if}}
          </tbody></table>
        </td>
        <td>
          <div class="bold">M/s. {{purchaser.name}}{{#if purchaser.invo}} &nbsp;&nbsp; INV: {{purchaser.invo}}{{/if}}</div>
          <table class="pkv"><tbody>
            <tr><td colspan="2">{{purchaser.addressFull}}</td></tr>
            <tr><td>STATE CODE: <span class="bold">{{purchaser.st_code}}</span></td><td class="rc">{{#if purchaser.sbl}}SBL: <span class="bold">{{purchaser.sbl}}</span>{{/if}}</td></tr>
            <tr><td>{{#if purchaser.gstin}}GSTIN: <span class="bold">{{purchaser.gstin}}</span>{{/if}}</td><td class="rc"></td></tr>
          </tbody></table>
        </td>
      </tr>
    </table>

    <!-- Line items -->
    <table class="items">
      <thead><tr>
        <th style="width:8%">S.No.</th><th style="width:37%">Description</th>
        <th style="width:18%">Quantity (kg.gr)</th><th style="width:15%">Rate</th><th style="width:22%">Cost</th>
      </tr></thead>
      <tbody>
        <tr>
          <td class="center">1</td><td>CARDAMOM (HSN: {{hsnCardamom}})</td>
          <td class="right">{{qtyg cardamom.qty}}</td><td class="right">{{rup cardamom.rate}}</td>
          <td class="right">{{rup cardamom.cost}}</td>
        </tr>
        {{#if sampleRefund}}
        <tr>
          <td class="center">2</td><td>SAMPLE REFUND</td>
          <td class="right">{{qtyg sampleRefund.qty}}</td><td class="right">{{rup sampleRefund.rate}}</td>
          <td class="right">{{rup sampleRefund.amount}}</td>
        </tr>
        {{/if}}
        {{#if traderSample}}
        <tr>
          <td class="center">3</td><td>TRADER SAMPLE</td>
          <td class="right">{{qtyg traderSample.qty}}</td><td class="right">({{rup traderSample.rate}})</td>
          <td class="right">({{rup traderSample.amount}})</td>
        </tr>
        {{/if}}
        <tr>
          <td class="center">4</td><td>COMMISSION</td>
          <td></td><td class="right">(1+2-3)*1%</td>
          <td class="right">({{rup commission.amount}})</td>
        </tr>
        <tr><td colspan="4" class="sumlbl">Taxable Value</td><td class="right bold">{{rup tax.taxable}}</td></tr>
        <tr><td colspan="4" class="sumlbl">CGST {{gstRate}}%</td><td class="right bold">{{rup tax.cgst}}</td></tr>
        <tr><td colspan="4" class="sumlbl">SGST {{gstRate}}%</td><td class="right bold">{{rup tax.sgst}}</td></tr>
        <tr><td colspan="4" class="sumlbl">IGST {{add gstRate gstRate}}%</td><td class="right bold">{{#if tax.igst}}{{rup tax.igst}}{{else}}0{{/if}}</td></tr>
        <tr><td colspan="4" class="sumlbl">Round Off</td><td class="right bold">{{rup roundDiff}}</td></tr>
        <tr><td colspan="4" class="sumlbl">Grand Total</td><td class="right bold">{{rup grandTotal}}</td></tr>
      </tbody>
    </table>

    <div class="words">Amount in Words: {{nettWords}}</div>
    <div class="forco">For {{cfg.short_name}}</div>
    <div class="sigrow"><span>Signature of the seller</span><span>Authorised Signatory</span></div>
  </div>
</div>
