{{#if first}}<style>
  /* Bill Statement — one page per SELLER, a row per lot.
     Deliberately the same furniture as templates/commission-bill/letterhead.hbs
     (letterhead, green bands, shared party box, words + signatory), because the
     two documents are the same transaction seen two ways: the Payment Voucher
     is one page per lot, this is one page per dealer. Keeping the CSS in step
     by eye is the cost of each .hbs being self-contained, which is the
     registry's bargain — a customer's layout travels in one editable file. */
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; }
  body { font-family: Helvetica, Arial, sans-serif; font-size: 8.5pt; color: #000; line-height: 1.3;
    -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .letterhead-page { padding: 22pt; }
  .letterhead-page + .letterhead-page { page-break-before: always; }
  .letterhead { --green: #4e8a3a; --green-soft: #e8f1e0; }
  .letterhead table { border-collapse: collapse; width: 100%; }
  .letterhead td, .letterhead th { border: 0.7pt solid #000; padding: 3pt 5pt; vertical-align: top; }
  .letterhead .lead { position: relative; padding: 8pt; text-align: center; border: 1pt solid #000; }
  .letterhead .lead.has-logo { padding-left: 78pt; padding-right: 78pt; min-height: 68pt; }
  .letterhead .logo { position: absolute; left: 8pt; top: 50%; transform: translateY(-50%);
    width: 62pt; height: 62pt; object-fit: contain; }
  .letterhead .co-name { font-weight: bold; font-size: 14pt; letter-spacing: .5pt; }
  .letterhead .co-sub { font-size: 8pt; }
  .letterhead .co-ids { display: flex; flex-wrap: wrap; justify-content: center; column-gap: 6pt; }
  .letterhead .co-ids:empty { display: none; }
  .letterhead .co-ids span { white-space: nowrap; }
  .letterhead .co-ids span + span::before { content: '|'; padding-right: 6pt; color: #555; }
  /* Party box — seller only. Half width, like the screenshot: a statement is
     addressed to ONE party, so a buyer column would be an empty box. */
  .letterhead .hdr td { background: var(--green-soft); font-weight: bold; text-align: center; }
  .letterhead .party td { font-size: 8pt; vertical-align: top; }
  .letterhead .pbwrap { width: 58%; border-collapse: collapse; margin-top: 8pt; }
  /* Auction / Date bands: two green chips with clear air between them. */
  .letterhead .bands { margin-top: 8pt; border: 0; }
  .letterhead .bands td { border: 0; padding: 0; }
  .letterhead .chip { background: var(--green); color: #fff; font-weight: bold;
    text-align: center; padding: 3pt 8pt; font-size: 8.5pt; }
  .letterhead .items { margin-top: 8pt; }
  .letterhead .items th { background: #fff; font-weight: bold; text-align: center; font-size: 9pt; }
  .letterhead .items td { font-size: 9pt; }
  .letterhead .right { text-align: right; } .letterhead .center { text-align: center; }
  .letterhead .bold { font-weight: bold; }
  /* The closing block: total, LESS TDS, Net. Each is a full table row so the
     column rules run unbroken to the foot of the table, as in the reference. */
  .letterhead .sum td { font-weight: bold; }
  .letterhead .words { padding: 7pt 2pt; font-weight: bold; font-size: 9pt; }
  .letterhead .forco { text-align: right; font-weight: bold; padding: 18pt 6pt 0; font-size: 10pt; }
  .letterhead .sigrow { text-align: right; font-weight: bold; font-size: 10pt; padding: 42pt 6pt 6pt; }
  .letterhead .pb { width: 100%; table-layout: fixed; border: 0; }
  .letterhead .pb td { height: auto; border: 0; padding: 0; font-size: 8pt; line-height: 1.15;
    vertical-align: top; white-space: nowrap; }
  .letterhead .pb td[colspan] { white-space: normal; }
  .letterhead .pb td.pb-r { width: 42%; }
  .letterhead .pb .pb-nm, .letterhead .pb .pb-v { font-weight: bold; }
</style>{{/if}}
<div class="letterhead-page letterhead">
  <!-- Letterhead -->
  <div class="lead{{#if co.logoDataUri}} has-logo{{/if}}">
    {{#if co.logoDataUri}}<img class="logo" src="{{co.logoDataUri}}">{{/if}}
    <div class="co-name">{{co.name}}</div>
    {{#if co.idValue}}<div class="co-sub">{{co.idLabel}}: {{co.idValue}}</div>{{/if}}
    <div class="co-sub">{{co.address1}}{{#if co.address2}}, {{co.address2}}{{/if}}</div>
    <div class="co-sub">{{co.place}}{{#if co.pin}} - {{co.pin}}{{/if}}{{#if co.stateName}}, {{co.stateName}}, CODE: {{co.stateCode}}.{{/if}}</div>
    {{#if co.phone}}<div class="co-sub">Ph: {{co.phone}}{{#if co.email}} E-mail: {{co.email}}{{/if}}</div>{{/if}}
    <div class="co-sub co-ids">{{#if co.fssai}}<span>FSSAI:&nbsp;{{co.fssai}}</span>{{/if}}{{#if co.gstin}}<span>GSTIN:&nbsp;{{co.gstin}}</span>{{/if}}</div>
    <div class="co-sub co-ids">{{#if co.sbl}}<span>SBL:&nbsp;{{co.sbl}}</span>{{/if}}{{#if co.pan}}<span>PAN:&nbsp;{{co.pan}}</span>{{/if}}</div>
  </div>

  <!-- Seller -->
  <table class="pbwrap">
    <tr class="hdr"><td>DETAILS OF SELLER [BILLED FOR]</td></tr>
    <tr class="party"><td>{{{partyBox seller.block prefix="Sri. "}}}</td></tr>
  </table>

  <!-- Trade + date -->
  <table class="bands">
    <tr>
      <td style="width:26%"><div class="chip">Auction No: {{ano}}</div></td>
      <td></td>
      <td style="width:26%"><div class="chip">Date: {{auctionDate}}</div></td>
    </tr>
  </table>

  <!-- Lots -->
  <table class="items">
    <thead><tr>
      <th style="width:7%">Sl.No.</th>
      <th style="width:10%">Lot No.</th>
      <th style="width:12%">Qty</th>
      <th style="width:15%">Amount</th>
      <th style="width:12%">Refund</th>
      <th style="width:15%">Commission</th>
      <th style="width:12%">GST</th>
      <th style="width:17%">Payable</th>
    </tr></thead>
    <tbody>
      {{#each rows}}
      <tr>
        <td class="center">{{this.sl}}</td>
        <td class="center">{{this.lot}}</td>
        <td class="right">{{qtyg this.qty}}</td>
        <td class="right">{{rup this.amount}}</td>
        <td class="right">{{rup this.refund}}</td>
        <td class="right">{{rup this.commission}}</td>
        <td class="right">{{rup this.gst}}</td>
        <td class="right">{{rup this.payable}}</td>
      </tr>
      {{/each}}
      <!-- Total of the Payable column. Qty and Amount are deliberately NOT
           totalled here: the reference sheet totals only what is being paid. -->
      <tr class="sum">
        <td></td><td></td><td></td><td></td><td></td><td></td><td></td>
        <td class="right">{{rup totalPayable}}</td>
      </tr>
      <tr class="sum">
        <td></td><td></td><td></td><td></td>
        <td></td><td>LESS:</td><td>TDS</td>
        <td class="right">{{rup tds}}</td>
      </tr>
      <tr class="sum">
        <td></td><td></td><td></td><td></td>
        <td></td><td>Net</td><td></td>
        <td class="right">{{rup net}}</td>
      </tr>
    </tbody>
  </table>

  <div class="words">Amount in words: {{netWords}}</div>
  <div class="forco">For {{cfg.short_name}}</div>
  <div class="sigrow">Authorised Signatory</div>
</div>
