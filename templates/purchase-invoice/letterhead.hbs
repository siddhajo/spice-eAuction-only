{{! A FRAGMENT, not a whole document: the batch renderer concatenates many of
    these into one HTML page, so a trade's purchase invoices cost one render
    per 25 rather than one each — and one watermark per rendered document
    instead of a 114 KB copy inside every invoice. `first` is per rendered
    DOCUMENT; the <style> below is emitted only by the first fragment in one.
    The page padding lives on .pi-page so every invoice keeps it, and the
    sibling rule starts each later invoice on a fresh sheet. }}
{{#if first}}<style>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body { font-family: Helvetica, Arial, sans-serif; font-size: 8pt; color: #000; line-height: 1.25;
    -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .pi-page { padding: 18pt; }
  /* Each invoice after the first starts a fresh sheet. THREE belts, because
     a lost page break is invisible until somebody prints a whole trade:
       1. `break-before` is the CSS Fragmentation property; `page-break-before`
          is the legacy alias. Both are emitted so a Chromium that has dropped
          either still breaks.
       2. The sibling rule needs the fragments to be adjacent siblings — it
          silently does nothing if anything lands between them, or if a
          template's root element stops being .pi-page.
       3. .pi-break is stamped per fragment by renderChunk(), and the element
          also carries the same declarations inline — which survives a missing
          stylesheet and any cascade. */
  .pi-page + .pi-page,
  .pi-break { break-before: page; page-break-before: always; }
  .doc { border: 0.7pt solid #000; }
  table { border-collapse: collapse; width: 100%; }
  td, th { border: 0.6pt solid #000; padding: 2pt 4pt; vertical-align: top; }
  .no-b, .no-b td, .no-b th { border: none; }
  .c { text-align: center; } .r { text-align: right; } .b { font-weight: bold; }
  .muted { font-size: 7.5pt; }
  /* Purchase = supplier's document, so NO logo (it is the seller's letterhead,
     not ours). Centred seller name/GSTIN with a little breathing room. */
  .head { text-align: center; padding: 7pt 8pt; }
  .head .co { font-weight: bold; font-size: 12pt; letter-spacing: .2pt; }
  .head .ln { font-size: 8pt; }
  /* Party cells: equal height so BILLED TO / SHIPPED TO read as two aligned
     columns even when one side has fewer lines. */
  .parties td { vertical-align: top; }
  /* Party box (the partyBox helper) — name, street, town-PIN, state+code,
     then the remaining details two per row. Fixed columns so the right-hand
     values line up down the box. */
  .parties .pb { width: 100%; table-layout: fixed; border-collapse: collapse; }
  .parties .pb td { height: auto; border: 0; padding: 0.4pt 0; font-size: 8pt; vertical-align: top; white-space: nowrap; }
  .parties .pb td[colspan] { white-space: normal; }
  .parties .pb .pb-nm, .parties .pb .pb-v { font-weight: bold; }
  /* Only the OUTER party cells take the fixed height — without the child
     combinator this also stretched every row of the nested party box. */
  .parties > tbody > tr:not(.bar) > td { height: 58pt; }
  /* Soft-green header/band + column-header fill, matching the commission bill. */
  .bar td { font-weight: bold; background: #e8f1e0; }
  .items th { font-weight: bold; font-size: 7pt; text-align: center; background: #e8f1e0; }
  .items td { font-size: 8pt; }
  .grand td { font-size: 11pt; font-weight: bold; }
  /* Fixed-width label so every colon in a label:value list lines up vertically.
     .lbl for the meta grid (longer labels), .lbl2 for the party GSTIN/PAN/STATE. */
  .lbl { display: inline-block; width: 92pt; }
  .lbl2 { display: inline-block; width: 34pt; }
</style>{{/if}}
<div class="pi-page{{#if pageBreak}} pi-break{{/if}}"{{#if pageBreak}} style="break-before:page;page-break-before:always"{{/if}}>
<div class="doc">
  <!-- Seller letterhead -->
  <div class="head">
    <div class="co">{{seller.name}}</div>
    {{#if seller.addr}}<div class="ln b">{{seller.addr}}</div>{{/if}}
    {{#if seller.gstin}}<div class="ln b">GSTIN.{{seller.gstin}}</div>{{/if}}
  </div>

  <!-- Meta grid: seller/transport (left) + invoice/supply (right) -->
  <table>
    {{#each leftPairs}}
    <tr>
      <td class="b" style="width:50%"><span class="lbl">{{this.[0]}}</span>: {{this.[1]}}</td>
      {{#with (lookup ../rightPairs @index)}}<td class="b" style="width:50%"><span class="lbl">{{this.[0]}}</span>: {{this.[1]}}</td>{{/with}}
    </tr>
    {{/each}}
  </table>

  <!-- Parties -->
  <table class="parties">
    <tr class="bar c b"><td style="width:50%">BILLED TO</td><td style="width:50%">SHIPPED TO</td></tr>
    <tr>
      <td>{{{partyBox buyerBlock}}}</td>
      <td>{{{partyBox buyerBlock}}}</td>
    </tr>
  </table>

  <table><tr class="bar c b"><td style="width:50%">Description of Goods: {{descGoods}}</td><td style="width:50%">HSN CODE: {{hsnCode}}</td></tr></table>

  <!-- Line items -->
  <table class="items">
    <thead><tr>
      <th style="width:28pt">Lot<br>No</th>
      <th>Quantity (kg)</th>
      <th>Sample (kg)</th>
      <th>Discount (kg)</th>
      <th>Total Qty (kg)</th>
      <th>Price (Rs)</th>
      <th>Taxable Value (Rs)</th>
    </tr></thead>
    <tbody>
      {{#each rows}}
      <tr>
        <td class="c b">{{lot}}</td>
        <td class="r">{{qty qty}}</td>
        <td class="r">{{qty sample}}</td>
        <td class="r">{{qty discount}}</td>
        <td class="r">{{qty totalQty}}</td>
        <td class="r">{{fixed price 2}}</td>
        <td class="r">{{inr taxable}}</td>
      </tr>
      {{/each}}
      <tr class="b">
        <td colspan="4" class="c">Total</td>
        <td class="r">{{qty totals.totalQtySum}}</td>
        <td></td>
        <td class="r">{{inr totals.taxableSum}}</td>
      </tr>
    </tbody>
  </table>

  <!-- Note + tax box -->
  <table>
    <tr>
      <td class="b" style="width:50%; vertical-align:middle">
        We have supplied the above mentioned lots of {{descGoods}} for Auction Sales in Auction No: {{auctionNo}} Dated: {{shortDate saleDate}}
      </td>
      <td style="width:50%; padding:0">
        <table class="no-b">
          <tr><td class="r b">IGST {{gstRate}}%</td><td class="r b" style="width:45%">{{inr totals.totalIgst}}</td></tr>
          <tr><td class="r b">CGST {{gstHalf}}%</td><td class="r b">{{inr totals.totalCgst}}</td></tr>
          <tr><td class="r b">SGST {{gstHalf}}%</td><td class="r b">{{inr totals.totalSgst}}</td></tr>
          <tr><td class="r b">SubTotal</td><td class="r b">{{inr subTotal}}</td></tr>
        </table>
      </td>
    </tr>
  </table>

  <table>
    {{#if tdsAmount}}<tr class="b"><td style="width:50%">TDS on purchase of Goods [U/S 194Q]</td><td class="r">{{inr tdsAmount}}</td></tr>{{/if}}
    <tr class="b"><td>Round Off</td><td class="r">{{inr roundDiff}}</td></tr>
    <tr class="grand"><td>GrandTotal</td><td class="r">{{inr invoiceAmount}}</td></tr>
  </table>

  <table><tr class="c b"><td>Amount in words: {{invoiceAmountWords}}</td></tr></table>

  <!-- Footer -->
  <table class="no-b" style="margin-top:4pt">
    <tr><td class="muted" style="width:70%">Bank Account No :</td><td class="r b" style="width:30%">FOR</td></tr>
    <tr>
      <td class="muted" style="padding-top:20pt">Bank Branch &amp; IFSC<br><span class="muted">[Certified that the particulars given above are true and correct]</span></td>
      <td class="r b" style="padding-top:20pt">Authorised Signatory</td>
    </tr>
  </table>
</div>
</div>
