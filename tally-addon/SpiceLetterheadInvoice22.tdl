;;=============================================================================
;; Spice Letterhead Sales Invoice — TallyPrime add-on
;;=============================================================================
;;
;; Reproduces the app's "Letterhead" sales-invoice layout
;; (templates/sales-invoice/letterhead.hbs) as a Tally print format, so an
;; invoice printed from TallyPrime looks like one printed from the app.
;;
;; PAIRED WITH tally-xml.js. TWO values on the printed invoice have no native
;; Tally field and travel from the app as UDFs. They are declared in
;; [System: UDF] below and MUST be declared BEFORE the XML is imported —
;; Tally silently discards UDF tags it does not recognise. Load this TDL
;; first, then import.
;;
;;   SpiceAuctionNo  per voucher   auction number
;;   SpiceBuyerSBL   per voucher   buyer's Spices Board licence
;;
;; Lot number and bag count need NO UDF. They are native per-inventory-entry
;; fields — $BasicPackageMarks and $BasicNumPackages — which this site's own
;; BagLot.txt add-on already reads per entry. Vouchers imported before this
;; file was written therefore still print their lots correctly.
;;
;; The company's own identity block (name, address, FSSAI, SBL, PAN, bank) is
;; NOT read from the voucher — Tally's company master has no FSSAI/SBL fields.
;; It is set once in [System: Formula] below. EDIT THAT BLOCK before use.
;;
;; Install: see tally-addon/README.md
;;-----------------------------------------------------------------------------


;;=============================================================================
;; 1. COMPANY IDENTITY — pre-filled; change here if the app's settings change
;;=============================================================================
;; These mirror the `co.*` values the .hbs letterhead renders. Keep the
;; quotes. Leave a value as "" to drop that line from the printed header.

[System: Formula]

;; Pre-filled from the app's own settings (data/config.db → company_settings) so
;; the Tally print and the app's PDF cannot drift apart. The source key for each
;; is named alongside; re-read them from Settings → Company / Address (Kerala) /
;; Bank if anything changes there.

    SpiceCoName      : "RNS SPICES"                                    ;; trade_name
    SpiceCoIdLabel   : "Partnership"
    SpiceCoIdValue   : "2983/2022"                                     ;; partnership_name
    SpiceCoAddr1     : "Door No: 14/623,624,625, RNS BUILDING"         ;; kl_address1
    SpiceCoAddr2     : "PULIYANMALA CUMBUMMETTU ROAD"                  ;; kl_address2
    SpiceCoPlace     : "NIRAPPELKADA"                                  ;; kl_place
    SpiceCoPin       : "685552"                                        ;; kl_pin
    SpiceCoStateName : "KERALA"                                        ;; kl_state
    ;; MUST match tally_state_code (32 = Kerala). This was "33" and every Kerala
    ;; buyer was therefore treated as inter-state and charged IGST instead of
    ;; CGST+SGST — visible on the first rendered invoice.
    SpiceCoStateCode : "32"                                            ;; tally_state_code
    SpiceCoPhone     : "9747360094"                                    ;; kl_phone
    SpiceCoEmail     : "rnsspices@gmail.com"                           ;; kl_email
    SpiceCoFSSAI     : "11325999000223"                                ;; fssai
    SpiceCoGSTIN     : "32ABFFR1926E1ZK"                               ;; kl_gstin
    SpiceCoSBL       : "EAUC/CS/50015/15/2026-27"                      ;; sbl
    SpiceCoPAN       : "ABFFR1926E"                                    ;; pan

    ;; Bank block printed in the footer. Blank SpiceBankName hides all three.
    SpiceBankName    : "HDFC BANK - KATTAPPANA"                        ;; bank_kl_name
    SpiceBankAcct    : "50200093192105"                                ;; bank_kl_acct
    SpiceBankIFSC    : "HDFC0004681"                                   ;; bank_kl_ifsc

    ;; Goods description band + tax rate. SpiceGSTRate is the FULL rate (IGST);
    ;; the CGST/SGST columns each print half of it.
    SpiceHSNCard     : "09083120"
    SpiceGSTRate     : 5
    SpiceGSTHalf     : @@SpiceGSTRate / 2

    ;; Round-off ledger name, so it is excluded from the charge line items and
    ;; printed on its own row instead. Spelled EXACTLY as the app sends it
    ;; (`tally_round` = "ROUND ON/OFF", uppercase) — the charge filter compares
    ;; this string to $LedgerName, so a case mismatch would let round-off
    ;; through as a line item.
    SpiceRoundLedger : "ROUND ON/OFF"                                  ;; tally_round

    ;; Logo path, read LIVE from Tally's own company master so it always matches
    ;; whatever Company Alteration has configured (currently
    ;; C:\Program Files\TallyPrime\RNS_LOGO.jpeg). Nothing to keep in sync, and
    ;; it is the same file Tally's built-in e-Invoice format prints.
    ;;
    ;; To override with a specific file instead, replace the whole expression
    ;; with a quoted filename — Tally renders JPEG only, never PNG.
    SpiceLogoPath    : $LogoPath:Company:##SVCurrentCompany


;;=============================================================================
;; 2. UDF DECLARATIONS — must match UDF_NAMES in tally-xml.js exactly
;;=============================================================================
;; Indices are in Tally's user-definable range (20000+). Checked clear against
;; the other local TDL on this install, BagLot.txt, which declares no UDFs at
;; all — it only retitles existing fields. If a third add-on is ever loaded,
;; re-check for a clash: indices are a shared space per company, and a
;; collision corrupts values silently rather than raising an error.

[System: UDF]

    SpiceAuctionNo : String : 20003
    SpiceBuyerSBL  : String : 20004


;;=============================================================================
;; 3. DERIVED VALUES
;;=============================================================================

[System: Formula]

    ;; Intra-state when the buyer's GSTIN opens with our own state code. Drives
    ;; the CGST+SGST vs IGST split, exactly as the .hbs template does.
    SpiceIsIntra   : $$StringPart:$PartyGSTIN:0:2 = @@SpiceCoStateCode

    ;; Header lines, pre-assembled so a blank component never leaves a stray
    ;; comma or dash behind.
    SpiceAddrLine  : if $$IsEmpty:@@SpiceCoAddr2 then @@SpiceCoAddr1 else @@SpiceCoAddr1 + ", " + @@SpiceCoAddr2
    SpicePlaceLine : (if $$IsEmpty:@@SpiceCoPin then @@SpiceCoPlace else @@SpiceCoPlace + " - " + @@SpiceCoPin) + ", " + @@SpiceCoStateName + ", CODE: " + @@SpiceCoStateCode + "."
    SpicePhoneLine : "Ph: " + @@SpiceCoPhone + (if $$IsEmpty:@@SpiceCoEmail then "" else "  E-mail: " + @@SpiceCoEmail)

    ;; The two statutory-ID rows. Each half contributes nothing when its value
    ;; is blank, so a company with no FSSAI gets "GSTIN: …" alone rather than a
    ;; dangling separator.
    ;;
    ;; This was a call to a custom [Function:] via `$$Table:` — which is not how
    ;; TDL invokes a function, and the function has been deleted. Plain inline
    ;; conditionals do the same job with nothing left to get wrong.
    SpiceIdRow1    : (if $$IsEmpty:@@SpiceCoFSSAI then "" else "FSSAI: " + @@SpiceCoFSSAI + "  |  ") + (if $$IsEmpty:@@SpiceCoGSTIN then "" else "GSTIN: " + @@SpiceCoGSTIN)
    SpiceIdRow2    : (if $$IsEmpty:@@SpiceCoSBL   then "" else "SBL: "   + @@SpiceCoSBL   + "  |  ") + (if $$IsEmpty:@@SpiceCoPAN   then "" else "PAN: "   + @@SpiceCoPAN)

    ;; Title strip. A voucher flagged proforma in the app arrives in Tally as an
    ;; ordinary sales voucher, so this always reads TAX INVOICE — see README.
    SpiceDocTitle  : "TAX INVOICE"

    ;; ── BAND COLOUR ──────────────────────────────────────────────────────
    ;; The .hbs tints five rows soft green (#e8f1e0). Print backgrounds DO work
    ;; in a TDL print format — `Print BG` / `Print FG`, as used by the site's own
    ;; Customized Invoice.txt (`Print BG:Black`, `print bg :Light grey`). I had
    ;; previously said this was impossible; it is not.
    ;;
    ;; TDL takes NAMED colours, not hex, so this is the nearest to #e8f1e0 in
    ;; Tally's palette rather than an exact match. Change the name here to
    ;; retint every band at once — it is referenced by all five.
    ;; NOTE: not referenced any more. `Print BG` needs a LITERAL colour token
    ;; (`Print BG : Light Green`), not a formula returning a quoted string —
    ;; the reference always writes it literally. To retint, edit the four
    ;; `Print BG :` lines directly.
    SpiceBandBG    : "Light Green"

    ;; ── SAMPLE ROW ───────────────────────────────────────────────────────
    ;; A DISPLAY-ONLY deduction, derived exactly as the app derives it
    ;; (pdf/render-html-invoice.js): quantity = lot count × 0.100 kg, value =
    ;; 0.100 × the sum of the lot rates. It deliberately does NOT feed the
    ;; taxable value or the grand total, which is why it can be computed here
    ;; and needs nothing added to the Tally export.
    ;;
    ;; Verified against the reference invoice: 15 lots → 1.500 kg, and
    ;; 0.1 × Σ(rates) = 4,423.60, matching the printed figure to the paisa.
    ;;
    ;; Both figures come from SpiceCardLots — cardamom entries ONLY. Summing raw
    ;; InventoryEntries would fold in the Gunny line's 200/Nos rate and inflate
    ;; the sample.
    SpiceLotCount  : $$CollNumTotal:SpiceCardLots:1
    SpiceSampleQty : @@SpiceLotCount * 0.1
    SpiceSampleAmt : $$CollNumTotal:SpiceCardLots:$$Number:$Rate * 0.1

    ;; Stock-item names, as the app sends them (tally_item_cardamom /
    ;; tally_item_gunny). Used to tell a cardamom lot from the gunny line.
    SpiceItemCard  : "Cardamom"
    SpiceItemGunny : "Gunny"
    SpiceIsCardLot : $StockItemName = @@SpiceItemCard
    SpiceIsGunny   : $StockItemName = @@SpiceItemGunny

[Collection: SpiceCardLots]

    Type   : InventoryEntries : Voucher
    Filter : SpiceIsCardLot

    ;; e-Invoice QR payload. Prefers Tally's own formula — the one its built-in
    ;; e-Invoice format prints — and falls back to the voucher's stored field.
    ;; Either may be the populated one depending on whether this is a
    ;; print-after-save; taking both means not having to care which.
    SpiceQrValue   : if $$IsEmpty:@@eInvoiceQRCValue then $IRNQRCode else @@eInvoiceQRCValue


;;=============================================================================
;; 4. STYLES
;;=============================================================================
;; Point sizes track the .hbs stylesheet: 13pt company name, 10.5pt title,
;; 8pt body, 7.5pt fine print, 12pt grand total.

;; NOTE ON SYNTAX — the rule that cost two failed loads, both "T0051: Invalid
;; TDL flag syntax":
;;
;;   NEVER put an attribute on the same line as the [Definition] header.
;;
;; Not `[Style: X] : Font : "Arial" : Height : 13` (several attributes), and
;; not `[Line: X] : Field : Y` either (just one). Both are rejected. Every
;; attribute goes on its own indented line under the header:
;;
;;   [Line: X]
;;       Field : Y
;;
;; tests/tally-letterhead-udf.unit.js fails the build if a compact form is ever
;; reintroduced anywhere in this file.

[Style: SpiceCoName]
    Font   : "Arial"
    Height : 13
    Bold   : Yes

[Style: SpiceHeadLine]
    Font   : "Arial"
    Height : 9

[Style: SpiceHeadBold]
    Font   : "Arial"
    Height : 9
    Bold   : Yes

[Style: SpiceTitle]
    Font   : "Arial"
    Height : 11
    Bold   : Yes

[Style: SpiceBody]
    Font   : "Arial"
    Height : 9

[Style: SpiceBodyBold]
    Font   : "Arial"
    Height : 9
    Bold   : Yes

[Style: SpiceFine]
    Font   : "Arial"
    Height : 7
    Bold   : Yes

[Style: SpiceColHead]
    Font   : "Arial"
    Height : 8
    Bold   : Yes

;;-----------------------------------------------------------------------------
;; COLOUR — the .hbs fills its band rows with a soft green (#e8f1e0): the title
;; strip, the two party headers, the commodity band and the item column heads.
;;
;; A TDL print format has no background-fill attribute that is known to work
;; here, so those bands are rendered as BOLD TEXT IN A BOXED ROW instead. That
;; is the honest reproduction of the emphasis, not of the colour.
;;
;; Text colour DOES print — `Color` is a valid Style attribute. If you want the
;; bands tinted rather than plain, colouring the TEXT is the safe way to do it.
;; Uncomment this style and put `Use : SpiceBandText` on the band fields:
;;
;; [Style: SpiceBandText]
;;     Font   : "Arial"
;;     Height : 8
;;     Bold   : Yes
;;     Color  : Dark Green
;;
;; A background FILL would be `Background : <colour>` on the Line. It is
;; UNTESTED on this install and is not a documented print attribute — if you try
;; it and the add-on stops loading with a T0014 "Incorrect attribute" error,
;; that is why; remove the line and it will load again.
;;-----------------------------------------------------------------------------

[Style: SpiceGrand]
    Font   : "Arial"
    Height : 12
    Bold   : Yes


;;=============================================================================
;; 5. REPORT + FORM
;;=============================================================================

[Report: SpiceLHSalesInvoice]

    Form        : SpiceLHSalesInvoice
    Title       : "Auction Sales Invoice"
    ;; Printed in the context of the voucher the user has open.
    Object      : Voucher

    ;; ── IF THE QR STILL DOES NOT DRAW, UNCOMMENT THE NEXT LINE ───────────
    ;; The reference gates its whole e-invoice block on a PRINT-CONFIG flag:
    ;;
    ;;   [Part:LearnwellEQR]
    ;;   Invisible: NOT ##SAGSTWithQRInfo OR $$IsEmpty:@@eInvoiceQRCValue
    ;;              OR NOT @@IsVchGSTeInvAppl
    ;;
    ;; ##SAGSTWithQRInfo is Tally's own "print with QR info" setting. Tally's
    ;; built-in invoice reports set it; a from-scratch report like this one does
    ;; not, so if Tally only draws a QR when that flag is on, no amount of
    ;; layout work here will ever produce one.
    ;;
    ;; NOW ENABLED. Tally's print configuration showed
    ;;     "Print GST/e-Way Bill/e-Invoice details : No"
    ;; which is this very flag. With it off Tally suppresses the e-invoice QR
    ;; regardless of the layout — which is why no arrangement of this part ever
    ;; drew one, and why the part reserved space but stayed blank.
    ;;
    ;; Setting it on the Report means the QR prints without anyone having to
    ;; remember to flip the option at the print screen each time.
    ;;
    ;; If the add-on ever fails to load pointing at this line, comment it out
    ;; again and instead set that option to Yes manually in the print
    ;; configuration — same result, one extra keystroke per print.
    Set : SAGSTWithQRInfo : Yes

[Form: SpiceLHSalesInvoice]

    Parts       : SpiceLHHead, SpiceLHEInvoice, SpiceLHTitle, SpiceLHPartyHeadPart, SpiceLHParties
    Parts       : SpiceLHCommodity, SpiceLHItemHeadPart, SpiceLHItems, SpiceLHCharges, SpiceLHTotals
    Parts       : SpiceLHFoot
    Width       : 100% Page
    Height      : 100% Page
    Space Top   : 0.25 inches
    Space Bottom: 0.25 inches
    Space Left  : 0.25 inches
    Space Right : 0.25 inches
    ;; NO `Border` here — it is not a valid Form attribute (error T0014).
    ;; Border belongs on a Part, Line or Field. The .hbs template's outer box
    ;; around the whole document therefore has no direct equivalent; each Part
    ;; carries `Border : Thin Bottom` instead, which reproduces the horizontal
    ;; rules between sections. To box a section, put `Border : Thin Box` on
    ;; that Part.


;;=============================================================================
;; 6. LETTERHEAD BLOCK
;;=============================================================================

;; LOGO LEFT, COMPANY TEXT CENTRED — two sub-parts side by side.
;;
;; A Part can contain Parts (`Parts :`), and `Vertical : No` lays them out
;; horizontally. Both facts come from the site's own working "Customized
;; Invoice.txt", which builds its letterhead exactly this way.

[Part: SpiceLHHead]

    Parts    : SpiceLHLogoPart, SpiceLHHeadText
    Vertical : No
    Border   : Thin Box

;; THE LOGO IS DRAWN BY THE PART, not by a field.
;;
;; `Graph Type : <path>` on a Part renders the image; the Part then holds one
;; Line with one Field whose value is the empty string — the field exists only
;; to give the part something to lay out. This is lifted from the working
;; reference:
;;
;;     [Part :LearnWellLOGO]
;;         Graph Type: ##SALogoPath
;;         Height : 12% page
;;         Width : 15% Page
;;
;; My earlier attempt put `Type : Logo` on a FIELD, which is not a thing —
;; and `Height` on a Field is what raised T0014. On a PART, `Height` is valid.
;;
;; The path is @@SpiceLogoPath ($LogoPath:Company:##SVCurrentCompany) rather
;; than the reference's ##SALogoPath: that variable belongs to Tally's own
;; sales-print report and may not be set inside this custom report, whereas the
;; diagnostic strip proved the company-master lookup resolves here.
;;
;; Tally renders JPEG only, and only in Print / Preview — never on screen.

[Part: SpiceLHLogoPart]

    Graph Type : @@SpiceLogoPath
    Lines      : SpiceLHLogoLine
    Width      : 15% Page
    Height     : 12% Page
    Horizontal Alignment : Left
    Vertical   : No
    Invisible  : $$IsEmpty:@@SpiceLogoPath

[Line: SpiceLHLogoLine]
    Field : SpiceFldLogoEmpty

[Field: SpiceFldLogoEmpty]
    Set as : ""

[Part: SpiceLHHeadText]

    Lines : SpiceLHLogoCoLine, SpiceLHIdLine, SpiceLHAddrLine, SpiceLHPlaceLine
    Lines : SpiceLHPhoneLine, SpiceLHIdRow1, SpiceLHIdRow2
    Width : 85% Page

[Line: SpiceLHLogoCoLine]

    Fields    : SpiceFldCoName
    Space Top : 0.05 inches

[Field: SpiceFldCoName]

    Set as  : @@SpiceCoName
    Style   : SpiceCoName
    Align   : Centre
    Full Width : Yes

;; The remaining header lines are all full-width centred single fields. Each
;; hides itself when its source value is blank, so the header shrinks cleanly
;; on a company that has, say, no FSSAI.
[Line: SpiceLHIdLine]
    Field : SpiceFldIdLine

[Line: SpiceLHAddrLine]
    Field : SpiceFldAddrLine

[Line: SpiceLHPlaceLine]
    Field : SpiceFldPlaceLine

[Line: SpiceLHPhoneLine]
    Field : SpiceFldPhoneLine

[Line: SpiceLHIdRow1]
    Field : SpiceFldIdRow1

[Line: SpiceLHIdRow2]
    Field : SpiceFldIdRow2

[Field: SpiceFldIdLine]
    Set as    : @@SpiceCoIdLabel + ": " + @@SpiceCoIdValue
    Style     : SpiceHeadBold
    Align     : Centre
    Full Width: Yes
    Invisible : $$IsEmpty:@@SpiceCoIdValue

[Field: SpiceFldAddrLine]
    Set as    : @@SpiceAddrLine
    Style     : SpiceHeadLine
    Align     : Centre
    Full Width: Yes
    Invisible : $$IsEmpty:@@SpiceCoAddr1

[Field: SpiceFldPlaceLine]
    Set as    : @@SpicePlaceLine
    Style     : SpiceHeadLine
    Align     : Centre
    Full Width: Yes
    Invisible : $$IsEmpty:@@SpiceCoPlace

[Field: SpiceFldPhoneLine]
    Set as    : @@SpicePhoneLine
    Style     : SpiceHeadLine
    Align     : Centre
    Full Width: Yes
    Invisible : $$IsEmpty:@@SpiceCoPhone

[Field: SpiceFldIdRow1]
    Set as    : @@SpiceIdRow1
    Style     : SpiceHeadBold
    Align     : Centre
    Full Width: Yes
    Invisible : $$IsEmpty:@@SpiceIdRow1

[Field: SpiceFldIdRow2]
    Set as    : @@SpiceIdRow2
    Style     : SpiceHeadBold
    Align     : Centre
    Full Width: Yes
    Invisible : $$IsEmpty:@@SpiceIdRow2


;;=============================================================================
;; 6B. E-INVOICE BLOCK — IRN / Ack No / Ack Date / QR
;;=============================================================================
;; Sits directly under the letterhead, which is where the IRP details belong on
;; an e-invoice: QR at the top right, IRN and acknowledgement beside and below.
;;
;; THE LABELS ALWAYS PRINT, the values only when the voucher carries them. A
;; voucher that was never sent to the IRP shows the labels with nothing after
;; them — which is the point of a placeholder, and matches how the .hbs footer
;; already prints a bare "Electronic Reference Number:".
;;
;; FIELD NAMES ARE BEST-GUESS and need confirming against a voucher that has
;; actually been e-invoiced. The app only ever sends <IRNACKDATE>, so that one
;; is certain; $IRN and $IRNAckNo are the conventional Tally spellings but are
;; unverified here. This is safe to ship unconfirmed: an unknown field name in
;; TDL yields an empty value rather than an error — proven on the first render,
;; where the footer's $IRN printed blank without breaking anything. If a value
;; stays stubbornly blank on a voucher that HAS an IRN, the field name is wrong,
;; not the layout.

;; IRN / Ack text on the left, QR on the right — two sub-parts side by side,
;; because the QR must be a PART (it cannot sit in a Line's field list).

[Part: SpiceLHEInvoice]

    Parts    : SpiceLHEInvText, SpiceLHQrPart
    ;; Explicit height so the QR sub-part has room. Without it the parent can
    ;; size to the text alone and clip the QR away entirely.
    Height   : 14% Page
    Vertical : No
    Border   : Thin Box

[Part: SpiceLHEInvText]

    Lines : SpiceLHEInvIrn, SpiceLHEInvAck, SpiceLHEInvEway
    Width : 78% Page

[Line: SpiceLHEInvIrn]

    Fields : SpiceFldEInvIrn

[Line: SpiceLHEInvAck]

    Fields : SpiceFldEInvAckNo, SpiceFldEInvAckDt

[Line: SpiceLHEInvEway]

    Fields : SpiceFldEInvEway

;; E-WAY BILL NUMBER — placeholder, same contract as IRN and Ack: the label
;; always prints, the value only when the voucher carries one.
;;
;; Like the IRN, the number is issued by the portal, not by the app: the export
;; sends <EWAYBILLDETAILS.LIST> (consignor, consignee, transport, distance) but
;; no number, so nothing app-side has to change for this to fill in.
;;
;; TWO CANDIDATE FIELD NAMES, tried in order. The number lives inside Tally's
;; EWayBillDetails sub-object, so the voucher-level spelling is not certain —
;; and an unknown field name yields blank rather than an error, which is what
;; makes trying both free. If it stays blank on a voucher that HAS an e-way
;; bill, neither name is right and it needs reading out of the sub-collection
;; instead; that is a change here, not in the app.
[Field: SpiceFldEInvEway]
    ;; STATIC LABEL ONLY — deliberately no $ field references.
    ;; It previously read:
    ;;   "e-Way Bill No: " + (if $$IsEmpty:$EWayBillNo then $EWayBillNumber else $EWayBillNo)
    ;; Both names were guesses, neither resolved, and the QR beside it stopped
    ;; drawing at the same time. Restore a real field name here only once it is
    ;; confirmed on a voucher that actually carries an e-way bill.
    Set as : "e-Way Bill No: "
    Style  : SpiceBody
    Align  : Left
    Width  : 70% Page

[Field: SpiceFldEInvIrn]
    Set as : "IRN No: " + $IRN
    Style  : SpiceBody
    Align  : Left
    Width  : 70% Page

[Field: SpiceFldEInvAckNo]
    Set as : "Ack No: " + $IRNAckNo
    Style  : SpiceBody
    Align  : Left
    Width  : 35% Page

[Field: SpiceFldEInvAckDt]
    ;; ONLY printed when the voucher actually carries an IRN.
    ;;
    ;; tally-xml.js emits <IRNACKDATE> as `dateval` — the INVOICE date — on
    ;; every sales voucher, e-invoiced or not. Printed unconditionally that put
    ;; "Ack Date: 19-Aug-26" on invoice RNS/I-4, which has no IRN and no Ack No
    ;; and was never sent to the IRP. A fabricated acknowledgement date on a tax
    ;; document is worse than a blank one, so the value is gated on $IRN.
    Set as : "Ack Date: " + (if $$IsEmpty:$IRN then "" else $$String:$IRNAckDate)
    Style  : SpiceBody
    Align  : Left
    Width  : 35% Page
    Border : Thin Left

;; QR CODE — drawn by the PART, exactly like the logo.
;;
;;     QR Code : <payload expression> : <logical>
;;
;; taken from the site's own working reference:
;;
;;     [Part: LWeInvoice QRC Title2]
;;         QRCode: @@eInvoiceQRCValue : Yes
;;         Width: 20% page
;;         Height: 10% Page
;;
;; As with the logo, the Part carries the image and holds one Line with one
;; empty Field. `Type : QR Code` on a Field — my earlier attempt — is not a
;; thing.
;;
;; PAYLOAD: @@SpiceQrValue prefers Tally's own @@eInvoiceQRCValue (what the
;; built-in e-Invoice format prints) and falls back to the voucher's
;; $IRNQRCode. The reference shows why both are worth having: its Ack No line
;; reads `If ##IseInvPSPrintAfterSave Then ##eInvPSAckNo Else $IRNAckNo` — the
;; session value during print-after-save, the stored field otherwise. The
;; fallback covers both without depending on that print-session variable.

[Part: SpiceLHQrPart]

    QRCode    : @@SpiceQrValue : Yes
    Lines     : SpiceLHQrLine
    Width     : 20% Page
    Height    : 10% Page
    Horizontal Alignment : Right
    Vertical  : No
    Invisible : $$IsEmpty:@@SpiceQrValue

[Line: SpiceLHQrLine]
    ;; `Info Field` is Tally's built-in — the reference QR line uses it
    ;; rather than a custom field. Kept SpiceFldQrEmpty defined but unused
    ;; so nothing dangles.
    Field : Info Field

[Field: SpiceFldQrEmpty]
    ;; MUST STAY EMPTY. The QR image is drawn by the Part; both QR parts in the
    ;; reference keep this field as "". Putting a marker letter here to identify
    ;; the variant is what stopped the QR drawing at all.
    Set as : ""

[Field: SpiceFldQrBandTxt]
    Set as : "B"
    Style  : SpiceFine
    Align  : Centre



;;=============================================================================
;; 7. TITLE STRIP
;;=============================================================================
;; Row 1: "AUCTION SALES INVOICE" centred, Sl.NO right.
;; Row 2: Auction No | TAX INVOICE | Date.

[Part: SpiceLHTitle]

    Lines  : SpiceLHTitleRow, SpiceLHSubRow
    ;; Tint applied DIRECTLY ON THE PART, which is the only form the working
    ;; reference uses for print backgrounds ([#Part: EXPINV Column] Print BG:Black).
    ;; The Line-level `Local : Field : Default : Print BG` form was tried first and
    ;; never rendered; the reference only ever uses that inside an Option.
    Print BG : Light Green
    Border : Thin Box

[Line: SpiceLHTitleRow]

    Fields       : SpiceFldDocHead
    Right Fields : SpiceFldSlNo
    Border       : Thin Bottom

[Field: SpiceFldDocHead]
    Set as    : "AUCTION SALES INVOICE"
    Style     : SpiceTitle
    Align     : Centre
    Full Width: Yes

[Field: SpiceFldSlNo]
    Set as : "Sl.NO: " + $VoucherNumber
    Style  : SpiceBodyBold
    Align  : Right
    Width  : 22% Page

[Line: SpiceLHSubRow]

    Fields : SpiceFldAuctionNo, SpiceFldTaxInv, SpiceFldDate

[Field: SpiceFldAuctionNo]
    ;; Auction number arrives from the app as a voucher UDF.
    Set as : "Auction No: " + $SpiceAuctionNo
    Style  : SpiceBodyBold
    Align  : Left
    Width  : 35% Page

[Field: SpiceFldTaxInv]
    Set as : @@SpiceDocTitle
    Style  : SpiceBodyBold
    Align  : Centre
    Width  : 30% Page

[Field: SpiceFldDate]
    ;; NOTE: Format : "DD/MM/YYYY" was tried here and had no effect —
    ;; the printed date format follows Tally's own configuration, not this
    ;; field. Change it in Tally rather than here.
    Set as : "Date: " + $$String:$Date
    Style  : SpiceBodyBold
    Align  : Right
    Width  : 35% Page


;;=============================================================================
;; 8. PARTIES — Billed To (left) / Shipped To (right)
;;=============================================================================
;; The app mirrors Billed-To into Shipped-To when a row has no separate
;; consignee. Tally already does the same via ConsigneeMailingName defaulting
;; to the party, so both columns always render a full block.

[Part: SpiceLHPartyHeadPart]

    Lines  : SpiceLHPartyHead
    ;; Tint applied DIRECTLY ON THE PART, which is the only form the working
    ;; reference uses for print backgrounds ([#Part: EXPINV Column] Print BG:Black).
    ;; The Line-level `Local : Field : Default : Print BG` form was tried first and
    ;; never rendered; the reference only ever uses that inside an Option.
    Print BG : Light Green
    Border : Thin Box

[Part: SpiceLHItemHeadPart]

    Lines  : SpiceLHItemHead
    ;; Tint applied DIRECTLY ON THE PART, which is the only form the working
    ;; reference uses for print backgrounds ([#Part: EXPINV Column] Print BG:Black).
    ;; The Line-level `Local : Field : Default : Print BG` form was tried first and
    ;; never rendered; the reference only ever uses that inside an Option.
    Print BG : Light Green
    Border : Thin Box

[Part: SpiceLHParties]

    ;; Order follows the reference: name, address, place|PAN, STATE|CODE,
    ;; GST|SBL.
    Lines  : SpiceLHPartyName, SpiceLHPartyAddr
    Lines  : SpiceLHPartyPan, SpiceLHPartyState, SpiceLHPartyGst
    Border : Thin Box

[Line: SpiceLHPartyHead]

    Fields : SpiceFldBillHead, SpiceFldShipHead
    Border : Thin Bottom

[Field: SpiceFldBillHead]
    Set as : "Details of the Receiver (Billed To)"
    Style  : SpiceBodyBold
    Align  : Centre
    Width  : 50% Page

[Field: SpiceFldShipHead]
    Border : Thin Left
    Set as : "Details of the Consignee (Shipped To)"
    Style  : SpiceBodyBold
    Align  : Centre
    Width  : 50% Page

;; ONE LINE PER DETAIL, two fields each (Billed To left, Shipped To right).
;;
;; This started as a single multi-line field per side, glued together with
;; $$NewLine and continuation lines. That failed at runtime with "Bad formula!"
;; because a continued line must NOT begin with a colon — the colon was being
;; read as part of the expression. Splitting into real Lines removes the
;; continuations and $$NewLine altogether, and isolates each expression, so a
;; problem in one detail no longer takes out the whole party block.
;;
;; It also aligns the two columns properly: row N on the left always sits
;; beside row N on the right.

[Line: SpiceLHPartyName]
    Fields : SpiceFldBillName, SpiceFldShipName

[Line: SpiceLHPartyAddr]
    Fields : SpiceFldBillAddr, SpiceFldShipAddr

[Line: SpiceLHPartyState]
    Fields : SpiceFldBillState, SpiceFldBillCode, SpiceFldShipState, SpiceFldShipCode

[Line: SpiceLHPartyGst]
    Fields : SpiceFldBillGst, SpiceFldBillSbl, SpiceFldShipGst, SpiceFldShipSbl

[Line: SpiceLHPartyPan]
    Fields : SpiceFldBillPlace, SpiceFldBillPan, SpiceFldShipPlace, SpiceFldShipPan

;; ── Billed To ───────────────────────────────────────────────────────────

;; ── Party grid: two 25% columns inside each 50% half ──────────────────
[Field: SpiceFldBillPlace]
    Set as : $BillToPlace
    Style  : SpiceBody
    Align  : Left
    Width  : 25% Page

[Field: SpiceFldBillPan]
    Set as : "PAN   : " + $$StringPart:$PartyGSTIN:2:10
    Style  : SpiceBody
    Align  : Left
    Width  : 25% Page

[Field: SpiceFldShipPlace]
    Set as : $ShipToPlace
    Style  : SpiceBody
    Align  : Left
    Width  : 25% Page

[Field: SpiceFldShipPan]
    Set as : "PAN   : " + $$StringPart:$ConsigneeGSTIN:2:10
    Style  : SpiceBody
    Align  : Left
    Width  : 25% Page

[Field: SpiceFldBillState]
    Set as : "STATE : " + $StateName
    Style  : SpiceBody
    Align  : Left
    Width  : 25% Page

[Field: SpiceFldBillCode]
    Set as : "CODE  : " + $$StringPart:$PartyGSTIN:0:2
    Style  : SpiceBody
    Align  : Left
    Width  : 25% Page

[Field: SpiceFldShipState]
    Set as : "STATE : " + $StateName
    Style  : SpiceBody
    Align  : Left
    Width  : 25% Page

[Field: SpiceFldShipCode]
    Set as : "CODE  : " + $$StringPart:$ConsigneeGSTIN:0:2
    Style  : SpiceBody
    Align  : Left
    Width  : 25% Page

[Field: SpiceFldBillGst]
    Set as : "GST   : " + $PartyGSTIN
    Style  : SpiceBody
    Align  : Left
    Width  : 25% Page

[Field: SpiceFldBillSbl]
    Set as : "SBL   : " + $SpiceBuyerSBL
    Style  : SpiceBody
    Align  : Left
    Width  : 25% Page

[Field: SpiceFldShipGst]
    Set as : "GST   : " + $ConsigneeGSTIN
    Style  : SpiceBody
    Align  : Left
    Width  : 25% Page

[Field: SpiceFldShipSbl]
    Set as : "SBL   : " + $SpiceBuyerSBL
    Style  : SpiceBody
    Align  : Left
    Width  : 25% Page

[Field: SpiceFldBillName]
    Set as : "M/s. " + $PartyLedgerName
    Style  : SpiceBodyBold
    Align  : Left
    Width  : 50% Page

[Field: SpiceFldBillAddr]
    ;; $$FullList flattens the voucher's multi-line Address list into one
    ;; field. If the address prints blank or errors, this is the only line
    ;; affected — swap it for plain `$Address` to fall back to the first line.
    Set as : $$FullList:Address:$Address
    Style  : SpiceBody
    Align  : Left
    Width  : 50% Page
    Lines  : 3

[Field: SpiceFldShipName]
    Border : Thin Left
    Set as : "M/s. " + $ConsigneeMailingName
    Style  : SpiceBodyBold
    Align  : Left
    Width  : 50% Page

[Field: SpiceFldShipAddr]
    Border : Thin Left
    Set as : $$FullList:BasicBuyerAddress:$BasicBuyerAddress
    Style  : SpiceBody
    Align  : Left
    Width  : 50% Page
    Lines  : 3

[Part: SpiceLHCommodity]

    ;; `Lines`, not `Line` — a Part takes the plural. The singular was silently
    ;; ignored, which is why the commodity band once printed as nothing at all.
    Lines  : SpiceLHCommodityLine
    ;; Tint applied DIRECTLY ON THE PART, which is the only form the working
    ;; reference uses for print backgrounds ([#Part: EXPINV Column] Print BG:Black).
    ;; The Line-level `Local : Field : Default : Print BG` form was tried first and
    ;; never rendered; the reference only ever uses that inside an Option.
    Print BG : Light Green
    Border : Thin Box

[Line: SpiceLHCommodityLine]

    Field : SpiceFldCommodity

[Field: SpiceFldCommodity]
    Set as    : "Commodity: Cardamom  |  HSN: " + @@SpiceHSNCard
    Style     : SpiceBodyBold
    Align     : Centre
    Full Width: Yes


;;=============================================================================
;; 10. LINE ITEMS
;;=============================================================================
;; Two repeats, in the order the .hbs template lists them:
;;   a) goods  — over InventoryEntries (Cardamom lots, then Gunny)
;;   b) charges— over LedgerEntries, for Transport / Insurance and any other
;;               non-tax, non-party, non-round-off charge ledger
;;
;; The 11 columns below sum to 100% Page and mirror the template's column
;; order: Lot / Item / Qty / Bags / Rate / Value / Taxable / CGST / SGST /
;; IGST / Total.

;; TWO RULES this part broke, both raising "Could not find the Repeated Line!":
;;
;;   1. A line named in `Repeat` MUST also appear in the part's `Lines` list.
;;      `Lines` declares every line the part owns; `Repeat` only says which of
;;      them iterates over which collection.
;;   2. A Part repeats ONE line over ONE collection. Two `Repeat` attributes in
;;      a single part do not stack — goods and charges therefore need a part
;;      each, which is why SpiceLHCharges exists below.
;;
;; Splitting into two parts raised the question of how the totals row sums both.
;; The answer is NOT a part-level `Total :` list — that does not carry across
;; parts and cannot be read from a [System: Formula] at all, which printed every
;; total blank. Section 11 sums the two collections directly instead.

[Part: SpiceLHItems]

    ;; SpiceLHSampleRow is NOT repeated — only SpiceLHItemRow is. It renders
    ;; once, after the goods lines, exactly where the .hbs puts it.
    Lines  : SpiceLHItemRow, SpiceLHSampleRow
    Repeat : SpiceLHItemRow : InventoryEntries
    ;; No `Total :` here — see section 11. It does not carry across parts, so
    ;; totals are collection aggregates instead.
    Border : Thin Box

;; ── SAMPLE (display-only deduction) ──────────────────────────────────────
;; Lot blank · "Sample" · qty · bags blank · RATE cell carries the amount ·
;; VALUE cell carries it parenthesised as a deduction · taxable 0 · no tax.
;; That column assignment looks odd but it is what the .hbs does, and the
;; reference invoice confirms it.

[Line: SpiceLHSampleRow]

    Fields : SpiceFldSmpLot, SpiceFldSmpItem, SpiceFldSmpQty, SpiceFldSmpBags
    Fields : SpiceFldSmpRate, SpiceFldSmpValue, SpiceFldSmpTaxable
    Fields : SpiceFldSmpCGST, SpiceFldSmpSGST, SpiceFldSmpIGST, SpiceFldSmpTotal
    ;; No lots, no sample.
    Invisible : @@SpiceLotCount = 0

[Field: SpiceFldSmpLot]
    Set as : ""
    Width  : 6% Page

[Field: SpiceFldSmpItem]
    Border : Thin Left
    Set as : "Sample"
    Style  : SpiceBody
    Align  : Left
    Width  : 12% Page

[Field: SpiceFldSmpQty]
    Border : Thin Left
    Set as : @@SpiceSampleQty
    Style  : SpiceBody
    Align  : Right
    Width  : 10% Page

[Field: SpiceFldSmpBags]
    Border : Thin Left
    Set as : ""
    Width  : 5% Page

[Field: SpiceFldSmpRate]
    Border : Thin Left
    Set as : @@SpiceSampleAmt
    Style  : SpiceBody
    Align  : Right
    Width  : 9% Page

[Field: SpiceFldSmpValue]
    Border : Thin Left
    ;; Parenthesised to read as a deduction, matching the .hbs.
    Set as : "(" + $$String:@@SpiceSampleAmt + ")"
    Style  : SpiceBody
    Align  : Right
    Width  : 10% Page

[Field: SpiceFldSmpTaxable]
    Border : Thin Left
    ;; Explicitly zero — the sample never enters the taxable value.
    Set as : "0"
    Style  : SpiceBody
    Align  : Right
    Width  : 10% Page

[Field: SpiceFldSmpCGST]
    Border : Thin Left
    Set as : ""
    Width  : 9% Page

[Field: SpiceFldSmpSGST]
    Border : Thin Left
    Set as : ""
    Width  : 9% Page

[Field: SpiceFldSmpIGST]
    Border : Thin Left
    Set as : ""
    Width  : 9% Page

[Field: SpiceFldSmpTotal]
    Border : Thin Left
    Set as : ""
    Width  : 11% Page

[Line: SpiceLHItemHead]

    Fields : SpiceFldHLot, SpiceFldHItem, SpiceFldHQty, SpiceFldHBags, SpiceFldHRate
    Fields : SpiceFldHValue, SpiceFldHTaxable, SpiceFldHCGST, SpiceFldHSGST
    Fields : SpiceFldHIGST, SpiceFldHTotal
    Border : Thin Bottom

;; All eleven share the same style and alignment; only the caption and width
;; differ. `Use : SpiceFldColHeadBase` inherits the common three.

[Field: SpiceFldColHeadBase]
    Style : SpiceColHead
    Align : Centre
    ;; Reference stacks its captions on two lines.
    Lines : 2

[Field: SpiceFldHLot]
    Use    : SpiceFldColHeadBase
    Set as : "Lot" + $$NewLine + "No"
    Width  : 6% Page

[Field: SpiceFldHItem]
    Border : Thin Left
    Use    : SpiceFldColHeadBase
    Set as : "Item"
    Width  : 12% Page

[Field: SpiceFldHQty]
    Border : Thin Left
    Use    : SpiceFldColHeadBase
    Set as : "Qty" + $$NewLine + "(kg.gr)"
    Width  : 10% Page

[Field: SpiceFldHBags]
    Border : Thin Left
    Use    : SpiceFldColHeadBase
    Set as : "Bags"
    Width  : 5% Page

[Field: SpiceFldHRate]
    Border : Thin Left
    Use    : SpiceFldColHeadBase
    ;; Unit shown once here rather than repeated on every row. Gunny is the only
    ;; non-Kgs rate and it prints blank, so a single header unit is never wrong.
    Set as : "Rate (Kgs.)"
    Width  : 9% Page

[Field: SpiceFldHValue]
    Border : Thin Left
    Use    : SpiceFldColHeadBase
    Set as : "Value"
    Width  : 10% Page

[Field: SpiceFldHTaxable]
    Border : Thin Left
    Use    : SpiceFldColHeadBase
    Set as : "Taxable Value"
    Width  : 10% Page

[Field: SpiceFldHCGST]
    Border : Thin Left
    Use    : SpiceFldColHeadBase
    Set as : "CGST" + $$NewLine + $$String:@@SpiceGSTHalf + "%"
    Width  : 9% Page

[Field: SpiceFldHSGST]
    Border : Thin Left
    Use    : SpiceFldColHeadBase
    Set as : "SGST" + $$NewLine + $$String:@@SpiceGSTHalf + "%"
    Width  : 9% Page

[Field: SpiceFldHIGST]
    Border : Thin Left
    Use    : SpiceFldColHeadBase
    Set as : "IGST " + $$String:@@SpiceGSTRate + "%"
    Width  : 9% Page

[Field: SpiceFldHTotal]
    Border : Thin Left
    Use    : SpiceFldColHeadBase
    Set as : "Total"
    Width  : 11% Page

;;-----------------------------------------------------------------------------
;; (a) Goods rows — one per inventory entry
;;-----------------------------------------------------------------------------

[Line: SpiceLHItemRow]

    Fields : SpiceFldILot, SpiceFldIItem, SpiceFldIQty, SpiceFldIBags, SpiceFldIRate
    Fields : SpiceFldIValue, SpiceFldITaxable, SpiceFldICGST, SpiceFldISGST
    Fields : SpiceFldIIGST, SpiceFldITotal

[Field: SpiceFldILot]
    ;; Native per-inventory-entry field — the same one BagLot.txt retitles to
    ;; "Lot No" on the voucher entry screen.
    ;;
    ;; On the GUNNY line this cell carries the LOT COUNT instead, sitting
    ;; directly under the lot numbers it totals — the .hbs does the same
    ;; ({{rows.length}}), and the reference invoice shows "15" there.
    Set as : if @@SpiceIsGunny then $$String:@@SpiceLotCount else $BasicPackageMarks
    Style  : SpiceBodyBold
    Align  : Centre
    Width  : 6% Page

[Field: SpiceFldIItem]
    Border : Thin Left
    Set as : $StockItemName
    Style  : SpiceBody
    Align  : Left
    Width  : 12% Page

[Field: SpiceFldIQty]
    Border : Thin Left
    ;; $BilledQty renders WITH its unit ("108.700 Kgs."). $$Number: strips it
    ;; to the bare figure; Format restores the three decimals the unit-bearing
    ;; form gave for free. The unit now lives in the column header instead.
    Set as : $$Number:$BilledQty
    Format : "Decimals: 3"
    Style  : SpiceBody
    Align  : Right
    Width  : 10% Page

[Field: SpiceFldIBags]
    Border : Thin Left
    ;; Native per-entry field. $$Number: guards against a blank entry (services
    ;; carry no package count) evaluating as a non-numeric.
    ;; Printed as-is. BasicNumPackages is a TEXT field in Tally ("No. & Kind of
    ;; Packages"), which is why BagLot.txt wraps it in $$Number: to SUM it —
    ;; displaying it needs no conversion.
    ;;
    ;; This was `$$String:$$Number:$BasicNumPackages` and printed blank on every
    ;; row while the Lot No beside it worked. Chained $$ calls without
    ;; parentheses mis-parse: the second function is read as an argument to the
    ;; first. Keep field reads plain.
    Set as : $BasicNumPackages
    Style  : SpiceBody
    Align  : Centre
    Width  : 5% Page

[Field: SpiceFldIRate]
    Border : Thin Left
    ;; Blank on the gunny line — the .hbs leaves that cell empty rather than
    ;; printing the 200.00/Nos gunny rate.
    ;;
    ;; $Rate renders WITH its unit ("3,298.00/Kgs."). Stripped here and shown
    ;; once in the column header. Gunny is the only non-Kgs rate and it prints
    ;; blank, so a single unit in the header is never wrong.
    Set as : if @@SpiceIsGunny then "" else $$Number:$Rate
    Format : "Decimals: 2"
    Style  : SpiceBody
    Align  : Right
    Width  : 9% Page

[Field: SpiceFldIValue]
    Border : Thin Left
    Set as : $$Abs:$Amount
    Style  : SpiceBody
    Align  : Right
    Width  : 10% Page

;; Taxable value equals the line value — the app bills tax-exclusive.
[Field: SpiceFldITaxable]
    Border : Thin Left
    Set as : $$Abs:$Amount
    Style  : SpiceBody
    Align  : Right
    Width  : 10% Page

;; Per-line tax, split by supply type. Computed from the line value rather than
;; read from the voucher's tax ledgers, which only carry invoice-level totals.
[Field: SpiceFldICGST]
    Border : Thin Left
    ;; BLANK WHEN THE WHOLE COLUMN IS ZERO. On an inter-state invoice every
    ;; CGST/SGST cell is 0 and on an intra-state one every IGST cell is; a
    ;; column of zeros is noise. Gated on the COLUMN TOTAL, not the cell, so a
    ;; genuine zero on one line still prints while the rest of the column has
    ;; figures.
    Set as : if @@SpiceTotCGST = 0 then "" else (if @@SpiceIsIntra then ($$Abs:$Amount * @@SpiceGSTHalf / 100) else 0)
    Style  : SpiceBody
    Align  : Right
    Width  : 9% Page

[Field: SpiceFldISGST]
    Border : Thin Left
    ;; BLANK WHEN THE WHOLE COLUMN IS ZERO. On an inter-state invoice every
    ;; CGST/SGST cell is 0 and on an intra-state one every IGST cell is; a
    ;; column of zeros is noise. Gated on the COLUMN TOTAL, not the cell, so a
    ;; genuine zero on one line still prints while the rest of the column has
    ;; figures.
    Set as : if @@SpiceTotSGST = 0 then "" else (if @@SpiceIsIntra then ($$Abs:$Amount * @@SpiceGSTHalf / 100) else 0)
    Style  : SpiceBody
    Align  : Right
    Width  : 9% Page

[Field: SpiceFldIIGST]
    Border : Thin Left
    ;; BLANK WHEN THE WHOLE COLUMN IS ZERO. On an inter-state invoice every
    ;; CGST/SGST cell is 0 and on an intra-state one every IGST cell is; a
    ;; column of zeros is noise. Gated on the COLUMN TOTAL, not the cell, so a
    ;; genuine zero on one line still prints while the rest of the column has
    ;; figures.
    Set as : if @@SpiceTotIGST = 0 then "" else (if @@SpiceIsIntra then 0 else ($$Abs:$Amount * @@SpiceGSTRate / 100))
    Style  : SpiceBody
    Align  : Right
    Width  : 9% Page

[Field: SpiceFldITotal]
    Border : Thin Left
    Set as : $$Abs:$Amount + (if @@SpiceIsIntra then ($$Abs:$Amount * @@SpiceGSTRate / 100) else ($$Abs:$Amount * @@SpiceGSTRate / 100))
    Style  : SpiceBody
    Align  : Right
    Width  : 11% Page

;;-----------------------------------------------------------------------------
;; (b) Charge rows — Transport / Insurance and similar service ledgers
;;-----------------------------------------------------------------------------
;; These are LEDGER entries in Tally, not inventory, so they need their own
;; repeat. Everything that is a tax ledger, the party ledger, or round-off is
;; filtered out — those belong in the totals block below, not as line items.

[Part: SpiceLHCharges]

    Lines  : SpiceLHChargeRow
    ;; Repeat over a FILTERED collection, not raw LedgerEntries.
    ;;
    ;; The first render repeated over LedgerEntries and relied on
    ;; `Invisible : NOT @@SpiceIsChargeLedger` on the line to suppress the
    ;; non-charges. It did not suppress them — the party ledger, CGST, SGST and
    ;; Round On/Off all printed as line items. Filtering the collection removes
    ;; them before the repeat ever sees them.
    Repeat : SpiceLHChargeRow : SpiceChargeLedgers
    Border : Thin Box

[Collection: SpiceChargeLedgers]

    Type   : LedgerEntries : Voucher
    Filter : SpiceChargeFilter

[System: Formula]

    SpiceChargeFilter : @@SpiceIsChargeLedger

;; The charge row uses its OWN field names rather than sharing the goods row's.
;; Sharing looked tidier, but the two rows evaluate in different object
;; contexts — a goods field reads $Amount off an inventory entry, a charge
;; field off a ledger entry — and a shared field cannot carry the
;; `@@SpiceIsChargeLedger` guard without that guard also firing on goods rows.
;; The totals block adds the two sets together, so nothing is lost.

[Line: SpiceLHChargeRow]

    Fields : SpiceFldCBlankLot, SpiceFldCItem, SpiceFldCBlankQty, SpiceFldCBlankBags, SpiceFldCBlankRate
    Fields : SpiceFldCValue, SpiceFldCTaxable, SpiceFldCCGST, SpiceFldCSGST
    Fields : SpiceFldCIGST, SpiceFldCTotal
    Invisible : NOT @@SpiceIsChargeLedger

[System: Formula]

    ;; A ledger entry is a printable CHARGE when it is not the party, not a tax
    ;; ledger, and not round-off. Those three belong in the totals block, not as
    ;; line items — and the party ledger carries the WHOLE invoice value, so
    ;; letting it through would roughly double the printed total.
    ;;
    ;; The party is matched by name against the voucher's own $PartyLedgerName
    ;; rather than by group: it needs no system-formula lookup and stays correct
    ;; whatever group the customer sits under.
    SpiceIsChargeLedger : $LedgerName != $PartyLedgerName AND +
                          $LedgerName != @@SpiceRoundLedger AND +
                          NOT $$IsLedOfGrp:$LedgerName:"Duties & Taxes" AND +
                          $$Abs:$Amount > 0

[Field: SpiceFldCItem]
    Border : Thin Left
    ;; Guarded like the money columns below: if the collection filter ever fails
    ;; to exclude a non-charge, this stops its NAME printing as a line item —
    ;; which is exactly how "ADITHYA SPICES", "CGST" and "ROUND ON/OFF" ended up
    ;; on the first rendered invoice.
    Set as : if @@SpiceIsChargeLedger then $LedgerName else ""
    Style  : SpiceBody
    Align  : Left
    Width  : 12% Page

;; Blanks. A ledger entry has no lot / qty / bags / rate, and referencing the
;; inventory fields here would evaluate them against the wrong object.

[Field: SpiceFldCBlankLot]
    Set as : ""
    Width  : 6% Page

[Field: SpiceFldCBlankQty]
    Border : Thin Left
    Set as : ""
    Width  : 10% Page

[Field: SpiceFldCBlankBags]
    Border : Thin Left
    Set as : ""
    Width  : 5% Page

[Field: SpiceFldCBlankRate]
    Border : Thin Left
    Set as : ""
    Width  : 9% Page

;; Money columns for a charge line.
;;
;; Every one is guarded with `if @@SpiceIsChargeLedger then … else 0`, even
;; though the line is already Invisible for non-charges. That is deliberate: a
;; hidden line may still accumulate into `Total:`, and an unguarded field would
;; feed the PARTY ledger's amount — the entire invoice value — into the column
;; totals. Returning 0 makes the totals correct either way.

[Field: SpiceFldCValue]
    Border : Thin Left
    Set as : if @@SpiceIsChargeLedger then $$Abs:$Amount else 0
    Style  : SpiceBody
    Align  : Right
    Width  : 10% Page

[Field: SpiceFldCTaxable]
    Border : Thin Left
    Set as : if @@SpiceIsChargeLedger then $$Abs:$Amount else 0
    Style  : SpiceBody
    Align  : Right
    Width  : 10% Page

[Field: SpiceFldCCGST]
    Border : Thin Left
    Set as : if @@SpiceTotCGST = 0 then "" else (if @@SpiceIsChargeLedger AND @@SpiceIsIntra then ($$Abs:$Amount * @@SpiceGSTHalf / 100) else 0)
    Style  : SpiceBody
    Align  : Right
    Width  : 9% Page

[Field: SpiceFldCSGST]
    Border : Thin Left
    Set as : if @@SpiceTotSGST = 0 then "" else (if @@SpiceIsChargeLedger AND @@SpiceIsIntra then ($$Abs:$Amount * @@SpiceGSTHalf / 100) else 0)
    Style  : SpiceBody
    Align  : Right
    Width  : 9% Page

[Field: SpiceFldCIGST]
    Border : Thin Left
    Set as : if @@SpiceTotIGST = 0 then "" else (if @@SpiceIsChargeLedger AND NOT @@SpiceIsIntra then ($$Abs:$Amount * @@SpiceGSTRate / 100) else 0)
    Style  : SpiceBody
    Align  : Right
    Width  : 9% Page

[Field: SpiceFldCTotal]
    Border : Thin Left
    Set as : if @@SpiceIsChargeLedger then ($$Abs:$Amount + ($$Abs:$Amount * @@SpiceGSTRate / 100)) else 0
    Style  : SpiceBody
    Align  : Right
    Width  : 11% Page


;;=============================================================================
;; 11. TOTALS
;;=============================================================================
;; Totals come from COLLECTION AGGREGATES, not from the parts' `Total:` lists.
;;
;; The first render printed every total blank. `Total :` was declared on the two
;; item parts and read back with `$$Total:<field>` from the totals part below —
;; that does not carry across parts, and inside a [System: Formula] there is no
;; part context to read at all. The `Total :` declarations have been removed
;; rather than left lying around looking functional.
;;
;; `$$CollAmtTotal:<collection>:<expr>` sums a collection directly and needs no
;; part context. It is the amount-typed sibling of `$$CollNumTotal`, which this
;; site's BagLot.txt already uses in production over the same InventoryEntries
;; collection — so the idiom is known to resolve here.
;;
;; SpiceChargeLedgers is the FILTERED collection defined in section 10b, so the
;; party ledger, the GST ledgers and round-off are already excluded — summing it
;; raw is safe.

[System: Formula]

    SpiceGoodsAmt   : $$Abs:$$CollAmtTotal:InventoryEntries:$Amount
    SpiceChargeAmt  : $$Abs:$$CollAmtTotal:SpiceChargeLedgers:$Amount

    ;; Goods and charges are both taxable at the same rate, so the tax totals
    ;; are computed from the combined taxable value. Derived the same way as the
    ;; per-line columns, so the totals row can never disagree with the column
    ;; above it.
    SpiceTotTaxable : @@SpiceGoodsAmt + @@SpiceChargeAmt
    SpiceTotCGST    : if @@SpiceIsIntra then (@@SpiceTotTaxable * @@SpiceGSTHalf / 100) else 0
    SpiceTotSGST    : if @@SpiceIsIntra then (@@SpiceTotTaxable * @@SpiceGSTHalf / 100) else 0
    SpiceTotIGST    : if @@SpiceIsIntra then 0 else (@@SpiceTotTaxable * @@SpiceGSTRate / 100)

    SpiceSubTotal : @@SpiceTotTaxable + @@SpiceTotCGST + @@SpiceTotSGST + @@SpiceTotIGST

    ;; GRAND TOTAL is read from the PARTY ledger — it is what Tally itself holds
    ;; as the invoice value, and what the buyer owes. Taking it rather than
    ;; re-rounding a computed subtotal means the printed total can never
    ;; disagree with the voucher, and it drops the unverified `$$Round`.
    ;;
    ;; $$Abs because a sales voucher's party amount is signed by dr/cr and only
    ;; its magnitude is wanted here.
    SpiceGrand    : $$Abs:$$CollAmtTotal:SpicePartyLedgerColl:$Amount

    ;; Round Off falls out as the difference, so its sign is always right
    ;; without knowing Tally's dr/cr convention. It also acts as a check on this
    ;; layout: anything the line items fail to model (TCS, an unmatched charge
    ;; ledger) shows up here as a visibly large "round off" instead of silently
    ;; corrupting the grand total.
    SpiceRoundOff : @@SpiceGrand - @@SpiceSubTotal

    SpiceIsPartyLedger : $LedgerName = $PartyLedgerName

[Collection: SpicePartyLedgerColl]

    Type   : LedgerEntries : Voucher
    Filter : SpiceIsPartyLedger

[Part: SpiceLHTotals]

    Lines  : SpiceLHTotalRow, SpiceLHRoundRow, SpiceLHGrandRow, SpiceLHWordsRow
    Border : Thin Box

[Line: SpiceLHTotalRow]

    Fields : SpiceFldTotLabel, SpiceFldTotTaxable, SpiceFldTotCGST, SpiceFldTotSGST
    Fields : SpiceFldTotIGST, SpiceFldTotAll
    Border : Thin Top

[Field: SpiceFldTotLabel]
    Set as : "Total Taxable Value & Tax"
    Style  : SpiceBodyBold
    Align  : Right
    Width  : 52% Page

[Field: SpiceFldTotBase]
    Style : SpiceBodyBold
    Align : Right

[Field: SpiceFldTotTaxable]
    Border : Thin Left
    Use    : SpiceFldTotBase
    Set as : @@SpiceTotTaxable
    Width  : 10% Page

[Field: SpiceFldTotCGST]
    Border : Thin Left
    Use    : SpiceFldTotBase
    Set as : if @@SpiceTotCGST = 0 then "" else @@SpiceTotCGST
    Width  : 9% Page

[Field: SpiceFldTotSGST]
    Border : Thin Left
    Use    : SpiceFldTotBase
    Set as : if @@SpiceTotSGST = 0 then "" else @@SpiceTotSGST
    Width  : 9% Page

[Field: SpiceFldTotIGST]
    Border : Thin Left
    Use    : SpiceFldTotBase
    Set as : if @@SpiceTotIGST = 0 then "" else @@SpiceTotIGST
    Width  : 9% Page

[Field: SpiceFldTotAll]
    Border : Thin Left
    Use    : SpiceFldTotBase
    Set as : @@SpiceSubTotal
    Width  : 11% Page

[Line: SpiceLHRoundRow]

    Fields : SpiceFldRoundLabel, SpiceFldRoundVal

[Field: SpiceFldRoundLabel]
    Set as : "Round Off"
    Style  : SpiceBody
    Align  : Right
    Width  : 89% Page

[Field: SpiceFldRoundVal]
    Set as : @@SpiceRoundOff
    Style  : SpiceBody
    Align  : Right
    Width  : 11% Page

[Line: SpiceLHGrandRow]

    Fields : SpiceFldGrandLabel, SpiceFldGrandVal
    Border : Thin Top

[Field: SpiceFldGrandLabel]
    Set as : "Grand Total"
    Style  : SpiceGrand
    Align  : Right
    Width  : 70% Page

[Field: SpiceFldGrandVal]
    Set as : @@SpiceGrand
    Style  : SpiceGrand
    Align  : Right
    Width  : 30% Page

[Line: SpiceLHWordsRow]

    Field  : SpiceFldWords
    Border : Thin Top

[Field: SpiceFldWords]
    ;; NO literal "INR" here — $$InWords already prefixes the currency name, so
    ;; adding one printed "INR INR Fifty Four Lakh …" on the first real invoice.
    Set as    : "Amount in Words: " + $$InWords:@@SpiceGrand + " Only"
    Style     : SpiceBodyBold
    Align     : Left
    Full Width: Yes


;;=============================================================================
;; 12. FOOTER
;;=============================================================================

[Part: SpiceLHFoot]

    Lines : SpiceLHERN, SpiceLHEOE, SpiceLHBankRow, SpiceLHBankName
    Lines : SpiceLHBankAcct, SpiceLHBankIfsc, SpiceLHSignRow

[Line: SpiceLHERN]
    Field : SpiceFldERN

[Line: SpiceLHEOE]
    Field : SpiceFldEOE

[Field: SpiceFldERN]
    ;; Label only. The .hbs prints a bare "Electronic Reference Number:" because
    ;; the app has no IRN to fill it with — but section 6B now prints the real
    ;; IRN at the top of the invoice, and repeating a 64-character hash at the
    ;; foot is noise. Kept as the label for template fidelity, without the value.
    Set as    : "Electronic Reference Number:        [build: 2026-08-26-F]"
    Style     : SpiceFine
    Align     : Left
    Full Width: Yes

[Field: SpiceFldEOE]
    Set as    : "E & O.E certified that the particulars given above are true and correct"
    Style     : SpiceFine
    Align     : Left
    Full Width: Yes

;; Bank block centred, "For <company>" pinned right on the first band. One line
;; per detail, for the same reason as the party block above — no continuation
;; lines, no $$NewLine. Each hides itself when no bank is configured.
[Line: SpiceLHBankRow]

    Fields       : SpiceFldBankTitle
    Right Fields : SpiceFldForCo
    Space Top    : 0.05 inches

[Line: SpiceLHBankName]
    Field : SpiceFldBankName

[Line: SpiceLHBankAcct]
    Field : SpiceFldBankAcct

[Line: SpiceLHBankIfsc]
    Field : SpiceFldBankIfsc

[Field: SpiceFldBankTitle]
    Set as    : "Bank Details"
    Style     : SpiceBodyBold
    Align     : Centre
    Width     : 65% Page
    Invisible : $$IsEmpty:@@SpiceBankName

[Field: SpiceFldBankName]
    Set as    : @@SpiceBankName
    Style     : SpiceBody
    Align     : Centre
    Width     : 65% Page
    Invisible : $$IsEmpty:@@SpiceBankName

[Field: SpiceFldBankAcct]
    Set as    : "A/C# " + @@SpiceBankAcct
    Style     : SpiceBody
    Align     : Centre
    Width     : 65% Page
    Invisible : $$IsEmpty:@@SpiceBankName

[Field: SpiceFldBankIfsc]
    Set as    : "IFSC: " + @@SpiceBankIFSC
    Style     : SpiceBody
    Align     : Centre
    Width     : 65% Page
    Invisible : $$IsEmpty:@@SpiceBankName

[Field: SpiceFldForCo]
    Set as : "For " + @@SpiceCoName
    Style  : SpiceBodyBold
    Align  : Right
    Width  : 35% Page

[Line: SpiceLHSignRow]

    Fields       : SpiceFldSignBuyer
    Right Fields : SpiceFldSignAuth
    Space Top    : 0.45 inches

[Field: SpiceFldSignBuyer]
    Set as : "Signature of the authorized buyer"
    Style  : SpiceBodyBold
    Align  : Left
    Width  : 50% Page

[Field: SpiceFldSignAuth]
    Set as : "Authorised Signatory"
    Style  : SpiceBodyBold
    Align  : Right
    Width  : 35% Page


;;=============================================================================
;; 13. ATTACH POINT — how the user reaches this layout
;;=============================================================================
;; Adds Alt+L to an open voucher: from a sales invoice in display or alter
;; mode, Alt+L prints the letterhead layout.
;;
;; `Form: Voucher` is the long-stable object name for the voucher entry/display
;; form and is the safest hook across TallyPrime releases. See README for the
;; alternative — replacing Tally's default sales print format outright — which
;; depends on internal report names that shift between releases.

[#Form: Voucher]

    Add : Button : SpiceLHPrintButton

[Button: SpiceLHPrintButton]

    Key    : Alt + L
    Action : Print Report : SpiceLHSalesInvoice
    Title  : "Letterhead Print"
    ;; Sales vouchers only — the layout assumes a sales invoice. @@IsSales is
    ;; the system formula BagLot.txt already uses on this install, so it is
    ;; known to resolve here.
    Inactive : NOT @@IsSales

;;=============================================================================
;; end of file
;;=============================================================================
